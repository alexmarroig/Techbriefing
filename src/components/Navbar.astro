---
const { active = '' } = Astro.props;
const links = [
  ['Notícias', '/'],
  ['Agentes', '/agentes'],
  ['Guias', '/guias'],
  ['Prompts', '/prompts'],
  ['Ferramentas', '/ferramentas'],
  ['Ebooks', '/ebooks'],
  ['Sobre', '/sobre'],
];
---

<nav class="nav">
  <div class="nav-i">
    <a class="nav-logo" href="/" aria-label="Tech Briefing">
      <span class="brand-mark" aria-hidden="true">
        <span>TB</span>
      </span>
      <span class="brand-word">
        <span class="brand-main">Tech</span>
        <span class="brand-accent">Briefing</span>
      </span>
      <span class="brand-line">IA aplicada</span>
    </a>
    <button class="nav-toggle" aria-label="Abrir menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links">
      {links.map(([label, href]) => (
        <li><a href={href} class:list={[{ active: active === label }]}>{label}</a></li>
      ))}
    </ul>
    <a class="nav-nl" href="/newsletter">Newsletter</a>
  </div>
</nav>

<style is:global>
  .nav-logo {
    min-width: max-content;
  }
  .brand-line {
    display: inline-flex;
    margin-left: 4px;
    padding-left: 10px;
    border-left: 1px solid var(--line);
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav-links li a {
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  @media (max-width: 1120px) {
    .brand-line {
      display: none;
    }
    .nav-links li a {
      padding-inline: 10px;
    }
  }
  @media (max-width: 1024px) {
    .nav-links li a {
      font-size: 16px;
    }
  }
</style>
