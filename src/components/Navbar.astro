---
const { active = '' } = Astro.props;
const links = [
  ['Guias', '/'],
  ['Agentes', '/agentes-de-ia'],
  ['Ferramentas', '/ferramentas'],
  ['Ebooks', '/ebooks'],
  ['Artigos', '/arquivo'],
  ['Sobre', '/sobre'],
];
---

<nav class="nav">
  <div class="nav-i">
    <a class="nav-logo" href="/">
      <span class="brand-mark" aria-hidden="true">
        <span>TB</span>
      </span>
      <span class="brand-word">
        <span class="brand-main">Tech</span>
        <span class="brand-accent">Briefing</span>
      </span>
    </a>
    <button class="nav-toggle" aria-label="Menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links">
      {links.map(([label, href]) => (
        <li><a href={href} class:list={[{ active: active === label }]}>{label}</a></li>
      ))}
    </ul>
    <a class="nav-nl" href="/newsletter">Newsletter</a>
  </div>
</nav>
