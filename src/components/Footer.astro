---
const { active = '' } = Astro.props;
const columns = [
  { h: 'Pilares', ls: [['IA Aplicada', '/ia-aplicada'], ['Agentes', '/agentes'], ['Automação', '/automacao'], ['Ferramentas', '/ferramentas'], ['Guias', '/guias']] },
  { h: 'Recursos', ls: [['Ebooks', '/ebooks'], ['Newsletter', '/newsletter'], ['Comparativos', '/comparativo'], ['Arquivo', '/arquivo']] },
  { h: 'Institucional', ls: [['Sobre', '/sobre'], ['Metodologia', '/metodologia'], ['Contato', '/contato'], ['Privacidade', '/privacidade'], ['Termos', '/termos']] },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <div class="footer-logo">
          <span class="brand-mark" aria-hidden="true"><span>TB</span></span>
          <span class="brand-word"><span class="brand-main">Tech</span><span class="brand-accent">Briefing</span></span>
        </div>
        <p class="footer-desc">Curadoria editorial estratégica sobre IA, Agentes e Automação para profissionais e empresas.</p>
        <div class="footer-socials">
          <div class="footer-social">X</div>
          <div class="footer-social">in</div>
          <div class="footer-social">play</div>
          <div class="footer-social">@</div>
        </div>
      </div>
      {columns.map((col) => (
        <div>
          <div class="footer-col-h">{col.h}</div>
          <ul class="footer-links">
            {col.ls.map(([label, href]) => (
              <li><a href={href} class:list={[{ active: active === label || active === label.replace('Nossos ', '') }]}>{label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">&copy; 2026 Tech Briefing — Uma iniciativa Nexora Systems.</span>
      <div class="footer-bl">
        <a href="/privacidade">Privacidade</a>
        <a href="/termos">Termos</a>
        <a href="/cookies">Cookies</a>
      </div>
    </div>
  </div>
</footer>
