---
const { active = '' } = Astro.props;

const columns = [
  {
    h: 'Conteúdo',
    ls: [
      ['Notícias', '/'],
      ['IA Aplicada', '/ia-aplicada'],
      ['Agentes', '/agentes'],
      ['Guias', '/guias'],
      ['Prompts', '/prompts'],
      ['Ferramentas', '/ferramentas'],
      ['Comparativos', '/comparativo'],
      ['Arquivo', '/arquivo'],
    ],
  },
  {
    h: 'Recursos',
    ls: [
      ['Ebooks', '/ebooks'],
      ['Newsletter', '/newsletter'],
      ['Biblioteca de prompts', '/prompts'],
      ['Ferramentas recomendadas', '/ferramentas'],
      ['Anuncie', '/anuncie'],
    ],
  },
  {
    h: 'Institucional',
    ls: [
      ['Sobre', '/sobre'],
      ['Metodologia editorial', '/metodologia-editorial'],
      ['Como avaliamos', '/metodologia'],
      ['Contato', '/contato'],
      ['Privacidade', '/privacidade'],
      ['Termos', '/termos'],
      ['Cookies', '/cookies'],
    ],
  },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <div class="footer-logo">
          <span class="brand-mark" aria-hidden="true"><span>TB</span></span>
          <span class="brand-word">
            <span class="brand-main">Tech</span><span class="brand-accent">Briefing</span>
          </span>
        </div>

        <p class="footer-desc">
          Publicação editorial da Nexora Systems para quem quer entender o que vale
          a pena usar em IA, automação e ferramentas digitais.
        </p>

        <div class="footer-socials" aria-label="Canais do Tech Briefing">
          <a class="footer-social" href="/newsletter" aria-label="Newsletter">NL</a>
          <a class="footer-social" href="/contato" aria-label="Contato">@</a>
          <a class="footer-social" href="/anuncie" aria-label="Anuncie">AD</a>
        </div>
      </div>

      {columns.map((col) => (
        <div>
          <div class="footer-col-h">{col.h}</div>
          <ul class="footer-links">
            {col.ls.map(([label, href]) => (
              <li>
                <a
                  href={href}
                  class:list={[{ active: active === label || active === label.replace('Nossos ', '') }]}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">
        &copy; 2026 Tech Briefing - uma publicação editorial da Nexora Systems.
      </span>

      <div class="footer-bl">
        <a href="/privacidade">Privacidade</a>
        <a href="/termos">Termos</a>
        <a href="/cookies">Cookies</a>
      </div>
    </div>
  </div>
</footer>
