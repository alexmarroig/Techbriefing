---
const { active = '' } = Astro.props;
const columns = [
  { h: 'Conteúdo', ls: [['Guias', '/'], ['Agentes de IA', '/agentes-de-ia'], ['Automação', '/arquivo'], ['Ferramentas', '/ferramentas'], ['Comparativos', '/comparativo']] },
  { h: 'Produtos', ls: [['Ebooks', '/ebooks'], ['Nossos Apps', '/apps'], ['Newsletter', '/newsletter'], ['Anuncie', '/contato'], ['Afiliados', '/ferramentas']] },
  { h: 'Nexora', ls: [['Sobre', '/sobre'], ['Contato', '/contato'], ['Privacidade', '/contato'], ['Termos', '/contato']] },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <div class="footer-logo"><div class="nav-pip"></div><span>Tech Briefing</span></div>
        <p class="footer-desc">Portal editorial de referência em IA aplicada, automação e produtos digitais.</p>
        <div class="footer-socials">
          <div class="footer-social">X</div>
          <div class="footer-social">in</div>
          <div class="footer-social">play</div>
          <div class="footer-social">@</div>
        </div>
      </div>
      {columns.map((col) => (
        <div>
          <div class="footer-col-h">{col.h}</div>
          <ul class="footer-links">
            {col.ls.map(([label, href]) => (
              <li><a href={href} class:list={[{ active: active === label || active === label.replace('Nossos ', '') }]}>{label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">&copy; 2026 Tech Briefing — Uma iniciativa Nexora Systems.</span>
      <div class="footer-bl">
        <a href="/contato">Privacidade</a>
        <a href="/contato">Termos</a>
        <a href="/contato">Cookies</a>
      </div>
    </div>
  </div>
</footer>
