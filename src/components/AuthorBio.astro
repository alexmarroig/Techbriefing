---
const { author } = Astro.props;
---

<div class="author-bio">
  <div class="author-bio-avatar">
    {author.startsWith('Lucas') ? 'LF' : author.charAt(0)}
  </div>
  <div class="author-bio-content">
    <div class="author-bio-label">Especialista em Operações de IA</div>
    <div class="author-bio-name">{author}</div>
    <p class="author-bio-text">
      {author.startsWith('Lucas')
        ? "Lucas Faria é estrategista de operações e editor do TechBriefing. Com foco em ROI operacional, Lucas documenta como integrar agentes, automações e LLMs em fluxos de trabalho reais para escalar a produtividade profissional."
        : "Especialista técnico focado em aplicação prática de IA, colaborando com o TechBriefing para entregar análises baseadas em testes reais e implementações de mercado."}
    </p>
    <div class="author-bio-links">
      <a href="/metodologia">Como avaliamos o conteúdo →</a>
    </div>
  </div>
</div>

<style>
  .author-bio {
    display: flex;
    gap: 32px;
    padding: 56px 40px;
    margin-top: 80px;
    background: var(--bg-2);
    border-radius: 20px;
    border: 1px solid var(--line-s);
    align-items: center;
  }
  .author-bio-avatar {
    flex-shrink: 0;
    width: 90px;
    height: 90px;
    background: var(--bg-1);
    border: 1px solid var(--line-s);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-size: 28px;
    color: var(--amber);
  }
  .author-bio-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--amber);
    margin-bottom: 8px;
  }
  .author-bio-name {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }
  .author-bio-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-2);
    margin-bottom: 16px;
    max-width: 520px;
  }
  .author-bio-links a {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }
  .author-bio-links a:hover {
    color: var(--amber);
  }
  @media(max-width: 640px) {
    .author-bio { flex-direction: column; text-align: center; padding: 32px 20px; }
    .author-bio-text { margin-left: auto; margin-right: auto; }
  }
</style>
