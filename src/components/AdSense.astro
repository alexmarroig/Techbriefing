---
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || 'ca-pub-7195062504228428';
const isConfigured = typeof adsenseClientId === 'string' && adsenseClientId.startsWith('ca-pub-');
---

{isConfigured && (
  <>
    <meta name="google-adsense-account" content={adsenseClientId} />
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
      crossorigin="anonymous"
    >
    </script>
  </>
)}
