---
const mode = Astro.props.mode ?? 'head';
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-KJHRR82Q';
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-SL0K23D01V';
const googleTagId = import.meta.env.PUBLIC_GOOGLE_TAG_ID || 'G-KZBZNLBWHR';
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const conversionLabel = import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL;
const tagId = googleAdsId || googleTagId || gaMeasurementId;
---

{mode === 'head' && gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      'gtm.start': new Date().getTime(),
      event: 'gtm.js'
    });

    (function(w,d,s,l,i){
      var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtmId);
  </script>
)}

{mode === 'head' && tagId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${tagId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId, googleTagId, googleAdsId, conversionLabel }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = window.gtag || gtag;

      gtag('js', new Date());

      if (gaMeasurementId) {
        gtag('config', gaMeasurementId);
      }

      if (googleTagId && googleTagId !== gaMeasurementId) {
        gtag('config', googleTagId);
      }

      if (googleAdsId) {
        gtag('config', googleAdsId);
      }

      window.trackTechBriefingEvent = function(eventName, params) {
        if (!window.gtag) return;
        window.gtag('event', eventName, params || {});
      };

      window.trackEbookCheckout = function(params) {
        const payload = {
          currency: 'BRL',
          value: 37.00,
          items: [{
            item_id: 'ebook-agentes-ia-negocios',
            item_name: 'Agentes de IA para Negocios',
            item_category: 'Ebook',
            price: 37.00,
            quantity: 1
          }],
          ...params
        };

        window.trackTechBriefingEvent('begin_checkout', payload);

        if (googleAdsId && conversionLabel) {
          window.gtag('event', 'conversion', {
            send_to: `${googleAdsId}/${conversionLabel}`,
            value: payload.value,
            currency: payload.currency,
            transaction_id: payload.transaction_id || ''
          });
        }
      };
    </script>
  </>
)}

{mode === 'body' && gtmId && (
  <noscript>
    <iframe
      src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
      height="0"
      width="0"
      style="display:none;visibility:hidden"
    >
    </iframe>
  </noscript>
)}
