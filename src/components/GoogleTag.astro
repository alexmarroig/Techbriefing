---
const mode = Astro.props.mode ?? 'head';
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-KJHRR82Q';
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-SL0K23D01V';
const googleTagId = import.meta.env.PUBLIC_GOOGLE_TAG_ID || 'G-KZBZNLBWHR';
const configuredGoogleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const googleAdsId = configuredGoogleAdsId && configuredGoogleAdsId !== 'AW-123456789'
  ? configuredGoogleAdsId
  : 'AW-16452822769';
const configuredConversionLabel = import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL;
const conversionLabel = configuredConversionLabel && configuredConversionLabel !== 'XXXXXXXXXXXXXXX'
  ? configuredConversionLabel
  : 'fT_7CKati6wcEPHNqKU9';
const tagId = googleAdsId || googleTagId || gaMeasurementId;
const siteName = 'tech_briefing';
---

{mode === 'head' && gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    window.dataLayer = window.dataLayer || [];
    window.__loadTechBriefingGtm = function(){
      if (window.__techBriefingGtmLoaded) return;
      window.__techBriefingGtmLoaded = true;
      window.dataLayer.push({
        'gtm.start': new Date().getTime(),
        event: 'gtm.js'
      });

      (function(w,d,s,l,i){
        var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
        j.async=true;
        j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
        f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',gtmId);
    };
  </script>
)}

{mode === 'head' && tagId && (
  <>
    <script is:inline define:vars={{ tagId, gaMeasurementId, googleTagId, googleAdsId, conversionLabel, siteName }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = window.gtag || gtag;

      gtag('js', new Date());

      if (gaMeasurementId) {
        gtag('config', gaMeasurementId);
      }

      if (googleTagId && googleTagId !== gaMeasurementId) {
        gtag('config', googleTagId);
      }

      if (googleAdsId) {
        gtag('config', googleAdsId);
      }

      const baseEventParams = function(params) {
        return {
          site_name: siteName,
          page_path: window.location.pathname,
          page_location: window.location.href,
          page_title: document.title,
          ...params
        };
      };

      window.trackTechBriefingEvent = function(eventName, params) {
        const payload = baseEventParams(params || {});

        window.dataLayer.push({
          event: eventName,
          ...payload
        });

        if (!window.gtag) return;
        window.gtag('event', eventName, payload);
      };

      window.trackEbookCheckout = function(params) {
        const eventId = 'ebook_checkout_' + Date.now();
        const payload = {
          event_id: eventId,
          funnel_name: 'ebook_agentes_ia',
          page_type: 'ebook_landing',
          checkout_provider: 'kiwify',
          currency: 'BRL',
          value: 37.00,
          items: [{
            item_id: 'ebook-agentes-ia-negocios',
            item_name: 'Agentes de IA para Negocios',
            item_category: 'Ebook',
            price: 37.00,
            quantity: 1
          }],
          ...params
        };

        window.trackTechBriefingEvent('ebook_cta_click', {
          ...payload,
          event_id: eventId + '_cta'
        });

        window.trackTechBriefingEvent('begin_checkout', payload);
      };

      if (window.location.pathname.replace(/\/$/, '') === '/ebook-agentes-ia') {
        window.trackTechBriefingEvent('ebook_page_view', {
          funnel_name: 'ebook_agentes_ia',
          page_type: 'ebook_landing',
          currency: 'BRL',
          value: 37.00,
          item_id: 'ebook-agentes-ia-negocios',
          item_name: 'Agentes de IA para Negocios'
        });
      }

      window.__loadTechBriefingGtag = function(){
        if (window.__techBriefingGtagLoaded) return;
        window.__techBriefingGtagLoaded = true;
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + tagId;
        document.head.appendChild(script);
      };

      window.__loadTechBriefingTags = function(){
        if (window.__loadTechBriefingGtag) window.__loadTechBriefingGtag();
        if (window.__loadTechBriefingGtm) window.__loadTechBriefingGtm();
      };

      const scheduleTags = function(){
        const isEbookLanding = window.location.pathname.replace(/\/$/, '') === '/ebook-agentes-ia';
        const delay = isEbookLanding ? 1800 : 6500;
        const load = function(){
          window.setTimeout(window.__loadTechBriefingTags, delay);
        };
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(load, { timeout: isEbookLanding ? 3500 : 8000 });
        } else {
          load();
        }
      };

      if (document.readyState === 'complete') {
        scheduleTags();
      } else {
        window.addEventListener('load', scheduleTags, { once: true });
      }

      ['pointerdown', 'keydown', 'touchstart'].forEach(function(eventName) {
        window.addEventListener(eventName, window.__loadTechBriefingTags, {
          once: true,
          passive: true
        });
      });
    </script>
  </>
)}

{mode === 'body' && gtmId && (
  <noscript>
    <iframe
      src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
      height="0"
      width="0"
      style="display:none;visibility:hidden"
    >
    </iframe>
  </noscript>
)}
