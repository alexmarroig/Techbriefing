<script is:inline>
  // Dynamic persistent 24h timer in localStorage
  function startCountdown() {
    const timerElement = document.getElementById('countdown-timer');
    if (!timerElement) return;

    const key = 'agentes_ia_premium_offer_deadline';
    let deadline = localStorage.getItem(key);

    if (!deadline) {
      const now = new Date();
      now.setHours(now.getHours() + 24);
      deadline = now.getTime().toString();
      localStorage.setItem(key, deadline);
    }

    function update() {
      const now = new Date().getTime();
      let diff = parseInt(deadline) - now;

      if (diff <= 0) {
        // Reset timer for another 24h
        const nextDeadline = new Date();
        nextDeadline.setHours(nextDeadline.getHours() + 24);
        deadline = nextDeadline.getTime().toString();
        localStorage.setItem(key, deadline);
        diff = parseInt(deadline) - now;
      }

      const h = Math.floor(diff / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);

      const formatted = [
        h.toString().padStart(2, '0'),
        m.toString().padStart(2, '0'),
        s.toString().padStart(2, '0')
      ].join(':');

      timerElement.textContent = formatted;
    }

    update();
    setInterval(update, 1000);
  }

  // Interactive Accordion for FAQs
  function setupAccordion() {
    const btns = document.querySelectorAll('.faq-question-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        
        // Collapse all others
        btns.forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const panel = document.getElementById(b.getAttribute('data-faq-id'));
          if (panel) panel.style.maxHeight = null;
          const indicator = b.querySelector('.faq-icon-indicator');
          if (indicator) indicator.textContent = '+';
        });

        // Toggle self
        if (!isExpanded) {
          btn.setAttribute('aria-expanded', 'true');
          const panel = document.getElementById(btn.getAttribute('data-faq-id'));
          if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
          const indicator = btn.querySelector('.faq-icon-indicator');
          if (indicator) indicator.textContent = '−';
        }
      });
    });
  }

  // Forward UTM tracking parameters to checkout links
  function forwardTrackingParameters() {
    const searchParams = new URLSearchParams(window.location.search);
    if (searchParams.toString().length === 0) return;

    // Select all links going to pay.kiwify.com.br
    const links = document.querySelectorAll('a[href^="https://pay.kiwify.com.br/"]');
    links.forEach(link => {
      const href = link.getAttribute('href');
      try {
        const urlObj = new URL(href);
        
        // Copy parameters
        searchParams.forEach((value, key) => {
          urlObj.searchParams.set(key, value);
        });
        
        link.setAttribute('href', urlObj.toString());
      } catch (err) {
        console.error('Error forwarding URL parameters', err);
      }
    });
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    startCountdown();
    setupAccordion();
    forwardTrackingParameters();
  });
</script>
