---
import '../styles/global.css';
import GoogleTag from '../components/GoogleTag.astro';
import { EBOOK_OFFER } from '../data/ebookOffer.js';

const CONFIG = {
  bookTitle: 'Framework Operacional de Agentes de IA para Negócios',
  subtitle: 'Manual prático e definitivo para criar agentes que automatizam tarefas reais no seu negócio.',
  authorBrand: 'Nexora Systems',
  portalBrand: 'Tech Briefing',
  portalTagline: 'IA aplicada para negócios reais',

  fullPrice: 'R$ 97,00',
  currentPrice: 'R$ 37,00',
  currentLabel: 'Preço promocional hoje',
  buyLink: 'https://pay.kiwify.com.br/U0ynSdt', // Kiwify oficial

  heroBadge: 'Acesso imediato • E-book completo',
  heroHeadline: 'Pare de usar IA como chat. Crie agentes que operam e automatizam seu negócio.',
  heroSub: 'O manual operacional passo a passo para mapear processos, estruturar regras, desenhar fluxos e delegar tarefas operacionais para agentes de Inteligência Artificial — sem precisar de programadores.',

  pages: '180',
  chapters: '12',
  format: 'PDF + EPUB',
  language: 'Português (BR)',
  guaranteeText: 'Garantia incondicional de 7 dias. Leia, teste e aplique. Se achar que não gerou valor real para sua operação, devolvemos 100% do seu dinheiro. Sem perguntas, sem burocracia.',

  painPoints: [
    { 
      label: 'Você acha que usa IA, mas só terceiriza digitação', 
      desc: 'A IA responde bonito no chat. Só que quem continua copiando, revisando, colando, enviando e tratando erros é você. Isso não é automação, é só um teclado melhor.' 
    },
    { 
      label: 'Projetos sem método viram demos bonitas e frágeis', 
      desc: 'Qualquer chatbot montado de forma intuitiva impressiona no vídeo de demonstração, mas quebra e devolve o caos para sua mão no primeiro dado inesperado ou exceção.' 
    },
    { 
      label: 'Falta de conhecimento técnico travando você', 
      desc: 'Você acha que para automatizar e criar fluxos robustos de IA precisa de um time de desenvolvedores seniores ou de investimentos altíssimos em infraestrutura.' 
    },
    { 
      label: 'Perdido em um mar de ferramentas e tutoriais', 
      desc: 'Todo dia surge uma ferramenta nova. Sem entender a arquitetura fundamental por trás dos agentes, você fica pulando de galho em galho sem construir nada útil.' 
    }
  ],

  benefits: [
    {
      title: 'Mapeamento de Processos',
      desc: 'Aprenda a analisar a sua operação diária e identificar com precisão cirúrgica quais tarefas repetitivas têm potencial real de economia, escala ou lucro.'
    },
    {
      title: 'Os 6 Blocos de Arquitetura',
      desc: 'Desenhe sistemas de agentes robustos unindo: Modelo de Linguagem, Memória, Ferramentas, Regras/Limites, Observabilidade e Avaliação. Nenhum é opcional.'
    },
    {
      title: 'Framework de Decisão Único',
      desc: 'Saiba exatamente quando vale a pena usar IA no-code (Make, N8N, Coze), quando usar ferramentas com código (Cursor, Replit, Bolt) e quando simplificar.'
    },
    {
      title: 'Mapeamento do Papel Humano',
      desc: 'Entenda como reposicionar você e sua equipe de executores manuais para arquitetos e supervisores de sistemas inteligentes, gerando extrema alavancagem.'
    }
  ],

  outcomes: [
    { title: 'Agente de Atendimento', desc: 'Triar dúvidas complexas, buscar contexto em base de dados, responder com tom de voz alinhado e escalonar para humanos.' },
    { title: 'Agente SDR/Vendas', desc: 'Qualificar leads frios de forma personalizada, organizar oportunidades de funil e sugerir follow-ups cirúrgicos.' },
    { title: 'Agente de Conteúdo', desc: 'Transformar briefings brutos em pautas, roteiros, e-mails e posts consistentes com a identidade da sua marca.' },
    { title: 'Agente de Operações', desc: 'Mapear relatórios, ler solicitações recebidas, preencher ERPs externos e acionar integrações sem falhas.' }
  ],

  chaptersList: [
    { num: '01', title: 'O fim da IA como "chat"', desc: 'A transição definitiva de assistentes conversacionais passivos para executores operacionais autônomos.' },
    { num: '02', title: 'O que são agentes de IA (de verdade)', desc: 'A definição técnica e comercial que separa um chatbot superficial de um agente operacional de alta utilidade.' },
    { num: '03', title: 'Estudo de Caso: Agente de Qualificação', desc: 'Um fluxo operacional completo destrinchado do início ao fim para ilustrar a teoria na prática.' },
    { num: '04', title: 'Os 6 blocos de um agente moderno', desc: 'Modelo de linguagem, memória persistente, ferramentas externas, regras e limites, observabilidade e avaliação.' },
    { num: '05', title: 'Tipos de agentes para negócios', desc: 'Como categorizar e escolher entre agentes operacionais, analíticos, criativos, decisórios ou coordenadores.' },
    { num: '06', title: 'Single-agent vs. Multi-agent', desc: 'Quando a simplicidade é a decisão estratégica mais lucrativa e quando a complexidade de múltiplos agentes se justifica.' },
    { num: '07', title: 'No-code + IA: Construção acessível', desc: 'Como utilizar plataformas no-code para criar e plugar agentes em sistemas existentes sem escrever linhas de código.' },
    { num: '08', title: 'O Framework de 8 passos', desc: 'O passo a passo metódico para sair de uma dor de negócios e entregar um agente operacional validado e rodando.' },
    { num: '09', title: 'Casos reais de agentes em produção', desc: 'Como grandes empresas e operações digitais enxutas estão cortando custos e escalando com IA hoje.' },
    { num: '10', title: 'Erros comuns e como evitá-los', desc: 'O guia de sobrevivência com os padrões que fazem 90% dos projetos de agentes falharem em uso real.' },
    { num: '11', title: 'O futuro das empresas com agentes', desc: 'Como o design organizacional está mudando rápido e como se preparar para coordenar equipes híbridas.' },
    { num: '12', title: 'O que muda a partir de agora', desc: 'Diretrizes práticas e planos de ação para colocar seu primeiro agente em produção na próxima semana.' }
  ],

  audienceBullets: [
    {
      title: 'Empreendedores e Líderes',
      desc: 'Que desejam parar de perder tempo com tarefas repetitivas e querem automatizar a operação de suporte, marketing e vendas com processos que rodam sozinhos.'
    },
    {
      title: 'Consultores e Agências',
      desc: 'Que desejam subir o valor dos seus serviços, deixando de vender "prompts simples" para entregar sistemas de agentes robustos que geram ROI real para clientes.'
    },
    {
      title: 'Profissionais de Operações e Gestores',
      desc: 'Cansados de fluxos manuais frágeis e que querem se destacar no mercado projetando automações inteligentes de alta estabilidade.'
    }
  ],

  bonuses: [
    { title: 'Checklist de Mapeamento Operacional', desc: 'O template prático usado para auditar seu dia a dia e listar exatamente onde a IA gera retorno imediato.' },
    { title: 'Mapa Mental de Ferramentas de IA', desc: 'Um guia visual categorizado (No-code, Low-code e Code) para você escolher a plataforma ideal para cada projeto.' },
    { title: 'Plano de Ação de 7 Dias', desc: 'O passo a passo condensado para você planejar, testar e colocar seu primeiro agente operacional no ar.' }
  ],

  faq: [
    { 
      q: 'Preciso ter conhecimentos de programação para aplicar o framework?', 
      m: 'Não! O material foi escrito de forma clara e conceitual. Focamos em clareza de processo, arquitetura de sistemas e regras lógicas. Você aprenderá tanto a usar ferramentas no-code acessíveis quanto a coordenar ferramentas de geração de código.' 
    },
    { 
      q: 'O e-book é teórico ou prático?', 
      m: 'Ambos na medida exata. Apresentamos os modelos mentais e os princípios de arquitetura para você entender o que está fazendo, seguidos imediatamente por checklists, roteiros de passos e cenários de aplicação real.' 
    },
    { 
      q: 'Como vou receber o material?', 
      m: 'Imediatamente após a confirmação do pagamento. Você receberá um e-mail com os links para download dos arquivos digitais nos formatos PDF (ótimo para computadores/tablets) e EPUB (ideal para leitores como Kindle/celular).' 
    },
    { 
      q: 'Funciona para qualquer nicho ou tamanho de empresa?', 
      m: 'Sim. Os princípios de automação, triagem de dados, SDR inteligente e produtividade de conteúdo aplicam-se a qualquer operação comercial que lide com processamento de informações e fluxos de trabalho.' 
    },
    { 
      q: 'E se o conteúdo não fizer sentido para mim?', 
      m: 'Você conta com nossa garantia de satisfação de 7 dias. Se ler o livro, analisar os bônus e sentir que o framework não serve para sua realidade, basta nos enviar um e-mail ou solicitar o reembolso direto na Kiwify.' 
    }
  ]
};

const title = `${CONFIG.bookTitle} — Edição Premium`;
const description = 'Transforme IA em processo e automação real para suporte, SDR, conteúdo e operações. O playbook definitivo para criar agentes funcionais sem programar.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const absoluteImage = new URL('/images/ebook-agentes-ia-premium-cover.png', Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#030712" />
  <link rel="canonical" href={canonical} />
  
  <!-- Open Graph -->
  <meta property="og:type" content="product" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absoluteImage} />
  <meta property="og:site_name" content={CONFIG.portalBrand} />
  <meta property="product:price:amount" content="37.00" />
  <meta property="product:price:currency" content="BRL" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <GoogleTag />
</head>
<body class="premium-body">
<GoogleTag mode="body" />

<!-- GLOW BACKGROUNDS -->
<div class="glow-bg-container" aria-hidden="true">
  <div class="radial-glow-1"></div>
  <div class="radial-glow-2"></div>
  <div class="grid-overlay"></div>
</div>

<!-- DYNAMIC TOP STICKY BAR -->
<div class="offer-timer-bar">
  <div class="bar-wrap">
    <div class="timer-badge">
      <span class="pulse-dot"></span>
      <span class="timer-title">OFERTA ESPECIAL EXPIRA EM:</span>
      <span class="timer-countdown" id="countdown-timer">23:59:59</span>
    </div>
    <a href={CONFIG.buyLink} class="bar-cta-btn" data-cta-id="premium_topbar_checkout">Aproveitar Promoção</a>
  </div>
</div>

<div class="premium-layout-container">
  <!-- LOGO AND HEADER -->
  <header class="logo-header">
    <div class="header-logo-wrap">
      <div class="logo-mark" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <div class="logo-meta">
        <span class="logo-brand">{CONFIG.portalBrand}</span>
        <span class="logo-tagline">{CONFIG.portalTagline}</span>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="premium-hero">
    <div class="hero-grid">
      <div class="hero-text-content">
        <div class="premium-badge-tag">{CONFIG.heroBadge}</div>
        <h1 class="premium-headline">{CONFIG.heroHeadline}</h1>
        <p class="premium-subheadline">{CONFIG.heroSub}</p>

        <!-- Dynamic Offer Box -->
        <div class="premium-offer-box-inline">
          <div class="pricing-card">
            <div class="price-original">De: <span>{CONFIG.fullPrice}</span></div>
            <div class="price-highlight">
              <span class="price-val">{CONFIG.currentPrice}</span>
              <span class="price-lbl">{CONFIG.currentLabel}</span>
            </div>
            <div class="action-assurance">Acesso imediato no formato PDF e EPUB • Garantia Incondicional</div>
          </div>
          <a href={CONFIG.buyLink} class="btn-neon-action animate-pulse-neon" data-cta-id="premium_hero_checkout">
            QUERO MEU ACESSO AGORA →
          </a>
          <div class="safe-badges">
            <span>🛡️ Compra 100% Segura</span>
            <span>📱 Compatível com Celular & Kindle</span>
            <span>⚡ Envio Imediato por E-mail</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="book-container-3d">
          <div class="glowing-backlight"></div>
          <img src="/images/ebook-agentes-ia-premium-cover.png" alt="Capa do Framework de Agentes de IA para Negócios" class="premium-mockup-cover" width="400" height="570" />
          
          <div class="spec-metrics-panel">
            <div class="spec-item">
              <strong>{CONFIG.pages}</strong>
              <span>páginas</span>
            </div>
            <div class="spec-divider"></div>
            <div class="spec-item">
              <strong>{CONFIG.chapters}</strong>
              <span>capítulos</span>
            </div>
            <div class="spec-divider"></div>
            <div class="spec-item">
              <strong>{CONFIG.format}</strong>
              <span>formatos</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PAIN POINTS (FRUSTRAÇÕES) -->
  <section class="premium-section bg-section-dark">
    <div class="section-title-wrap">
      <span class="section-kicker">O CENÁRIO ATUAL</span>
      <h2 class="section-title">Você já passou por alguma dessas frustrações?</h2>
      <p class="section-desc">Usar Inteligência Artificial no dia a dia deveria liberar seu tempo, mas sem o framework correto, você só acumula processos manuais extras.</p>
    </div>

    <div class="cards-grid-2x2">
      {CONFIG.painPoints.map((p, idx) => (
        <div class="glass-feature-card hover-red-glow">
          <div class="card-num-indicator">0{idx + 1}</div>
          <h3 class="card-feature-title">{p.label}</h3>
          <p class="card-feature-desc">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- BENEFITS (O QUE CONSEGUE CONSTRUIR) -->
  <section class="premium-section">
    <div class="section-title-wrap">
      <span class="section-kicker">OS RESULTADOS PRÁTICOS</span>
      <h2 class="section-title">O que você conseguirá projetar e construir:</h2>
      <p class="section-desc">Sistemas que funcionam sozinhos em segundo plano, executando tomadas de decisão e gerando valor constante para o negócio.</p>
    </div>

    <div class="cards-grid-4col">
      {CONFIG.benefits.map((b, idx) => (
        <div class="glass-benefit-card">
          <div class="benefit-icon-box">
            <span class="num-glow-idx">{idx + 1}</span>
          </div>
          <h3 class="benefit-title">{b.title}</h3>
          <p class="benefit-desc">{b.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- AGENT OUTCOMES -->
  <section class="premium-section bg-section-dark overflow-hidden">
    <div class="outcomes-showcase-layout">
      <div class="outcomes-info-col">
        <span class="section-kicker">CASOS DE USO PRONTOS</span>
        <h2 class="section-title">Agentes com funções claras e utilidade real</h2>
        <p class="section-desc">Mapeamos a lógica exata de quatro categorias cruciais de agentes que você pode estruturar e implantar na sua empresa:</p>
        
        <div class="outcomes-bullet-list">
          {CONFIG.outcomes.map((o) => (
            <div class="outcome-bullet-item">
              <span class="bullet-check-neon">✓</span>
              <div>
                <strong>{o.title}</strong>
                <p>{o.desc}</p>
              </div>
            </div>
          ))}
        </div>
        
        <a href={CONFIG.buyLink} class="btn-inline-action" data-cta-id="premium_outcomes_checkout">
          Quero estruturar meus agentes agora →
        </a>
      </div>
      
      <div class="outcomes-visual-col">
        <div class="workflow-visual-card">
          <div class="window-header">
            <span class="window-dot red"></span>
            <span class="window-dot yellow"></span>
            <span class="window-dot green"></span>
            <span class="window-title">AI Agent Workflow Simulator</span>
          </div>
          <div class="visual-workflow-nodes">
            <div class="wf-node start">
              <span class="node-tag">ENTRADA</span>
              <strong>Lead Completa Formulário</strong>
            </div>
            <div class="wf-connector-line"></div>
            <div class="wf-node agent-node">
              <span class="node-tag agent">AGENT RAG</span>
              <strong>SDR Qualificador de IA</strong>
              <small>Processa perfil e cruza com base de leads</small>
            </div>
            <div class="wf-connector-line"></div>
            <div class="wf-grid-actions">
              <div class="wf-subnode success">
                <span class="node-tag ok">MONETIZAR</span>
                <strong>Agendar Venda (Link Pix)</strong>
              </div>
              <div class="wf-subnode info">
                <span class="node-tag alert">HUMAN-IN-THE-LOOP</span>
                <strong>Notificar Equipe (Exceção)</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTERS LIST (O CONTEÚDO) -->
  <section class="premium-section">
    <div class="section-title-wrap">
      <span class="section-kicker">CONTEÚDO COMPLETO</span>
      <h2 class="section-title">12 capítulos densos. Sem enrolação.</h2>
      <p class="section-desc">Um manual pragmático construído para ser consultado e aplicado no dia a dia da sua operação.</p>
    </div>

    <div class="chapters-grid-3col">
      {CONFIG.chaptersList.map((ch) => (
        <div class="glass-chapter-card">
          <div class="chapter-badge">MÓDULO {ch.num}</div>
          <h3 class="chapter-card-title">{ch.title}</h3>
          <p class="chapter-card-desc">{ch.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- AUDIENCE SECTION (PARA QUEM É) -->
  <section class="premium-section bg-section-dark">
    <div class="section-title-wrap">
      <span class="section-kicker">PÚBLICO-ALVO</span>
      <h2 class="section-title">Este framework operacional é para você se:</h2>
    </div>

    <div class="audience-grid-split">
      <div class="audience-column-green">
        <h3 class="aud-column-title">Ideal para quem quer construir valor:</h3>
        <div class="aud-bullet-cards">
          {CONFIG.audienceBullets.map((a) => (
            <div class="aud-card-item">
              <div class="aud-check-box">✓</div>
              <div>
                <strong>{a.title}</strong>
                <p>{a.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="audience-column-red">
        <h3 class="aud-column-title">NÃO serve para quem busca:</h3>
        <div class="aud-bullet-cards">
          <div class="aud-card-item red-theme">
            <div class="aud-check-box red-theme">✗</div>
            <div>
              <strong>Promessas de dinheiro fácil e rápido</strong>
              <p>Não vendemos métodos mágicos para ficar rico apertando botões. Criar agentes exige método, dedicação e teste.</p>
            </div>
          </div>
          <div class="aud-card-item red-theme">
            <div class="aud-check-box red-theme">✗</div>
            <div>
              <strong>Fórmulas milagrosas sem esforço</strong>
              <p>Se você não quer analisar processos, entender as regras e de fato estruturar a automação, este livro não ajudará você.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BONUSES -->
  <section class="premium-section">
    <div class="section-title-wrap">
      <span class="section-kicker">BÔNUS EXCLUSIVOS INCLUÍDOS</span>
      <h2 class="section-title">Leve estas 3 ferramentas de aceleração:</h2>
      <p class="section-desc">Materiais de apoio criados para cortar seu tempo de planejamento e implementação pela metade.</p>
    </div>

    <div class="cards-grid-3col">
      {CONFIG.bonuses.map((b, idx) => (
        <div class="glass-bonus-card">
          <div class="bonus-tag">BÔNUS 0{idx + 1}</div>
          <h3 class="bonus-card-title">{b.title}</h3>
          <p class="bonus-card-desc">{b.desc}</p>
          <span class="bonus-price-badge">INCLUÍDO GRATUITAMENTE</span>
        </div>
      ))}
    </div>
  </section>

  <!-- GUARANTEE PANEL -->
  <section class="premium-section bg-section-dark">
    <div class="glass-guarantee-panel-box">
      <div class="guarantee-badge-large">🛡️</div>
      <div class="guarantee-content-text">
        <h2 class="guarantee-panel-title">Você no controle absoluto: Garantia Incondicional de 7 dias</h2>
        <p class="guarantee-panel-desc">{CONFIG.guaranteeText}</p>
        <div class="guarantee-trust-stamps">
          <span>🔒 Transação Encriptada e Segura</span>
          <span>🛡️ Garantia Processada pela Kiwify</span>
        </div>
      </div>
    </div>
  </section>

  <!-- OFERTA FINAL -->
  <section class="premium-section final-checkout-section" id="compra-rapida">
    <div class="final-offer-container-glass">
      <div class="offer-highlight-glow"></div>
      
      <div class="final-offer-split">
        <div class="final-left-mockup">
          <img src="/images/ebook-agentes-ia-premium-cover.png" alt="Ebook Agentes de IA" class="final-mockup-img" width="300" height="425" />
        </div>
        
        <div class="final-right-details">
          <div class="pricing-badge-promo">OFERTA PROMOCIONAL HOJE</div>
          <h2 class="final-offer-title">{CONFIG.bookTitle}</h2>
          <p class="final-offer-subtitle">Receba o playbook digital completo com os bônus inclusos e comece a automatizar sua rotina imediatamente.</p>
          
          <ul class="final-features-checklist">
            <li><span class="chk-green">✓</span> Playbook Operacional Completo (180 páginas)</li>
            <li><span class="chk-green">✓</span> Checklist de Mapeamento Operacional</li>
            <li><span class="chk-green">✓</span> Mapa Mental de Ferramentas de IA</li>
            <li><span class="chk-green">✓</span> Plano de Ação de 7 Dias para Iniciantes</li>
            <li><span class="chk-green">✓</span> Acesso vitalício aos arquivos PDF + EPUB</li>
            <li><span class="chk-green">✓</span> Garantia de Satisfação Incondicional de 7 Dias</li>
          </ul>

          <div class="final-pricing-strip">
            <div class="final-price-original">De: R$ 97,00</div>
            <div class="final-price-current">
              <span class="price-actual">{CONFIG.currentPrice}</span>
