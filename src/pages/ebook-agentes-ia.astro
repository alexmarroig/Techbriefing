<script is:inline>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

document.querySelectorAll('[data-promo-end]').forEach(card => {
  const endDate = new Date(card.dataset.promoEnd || '').getTime();
  const days = card.querySelector('[data-countdown-days]');
  const hours = card.querySelector('[data-countdown-hours]');
  const minutes = card.querySelector('[data-countdown-minutes]');
  const seconds = card.querySelector('[data-countdown-seconds]');
  const note = card.querySelector('.lp-urgency-note');

  const render = () => {
    const distance = endDate - Date.now();
    if (!Number.isFinite(endDate) || distance <= 0) {
      card.classList.add('is-expired');
      if (days) days.textContent = '00';
      if (hours) hours.textContent = '00';
      if (minutes) minutes.textContent = '00';
      if (seconds) seconds.textContent = '00';
      if (note) note.textContent = 'Promoção encerrada. Confira o preço atual no checkout.';
      return;
    }

    const totalSeconds = Math.floor(distance / 1000);
    const totalMinutes = Math.floor(totalSeconds / 60);
    const dayValue = Math.floor(totalMinutes / 1440);
    const hourValue = Math.floor((totalMinutes % 1440) / 60);
    const minuteValue = totalMinutes % 60;
    const secondValue = totalSeconds % 60;

    if (days) days.textContent = String(dayValue).padStart(2, '0');
    if (hours) hours.textContent = String(hourValue).padStart(2, '0');
    if (minutes) minutes.textContent = String(minuteValue).padStart(2, '0');
    if (seconds) seconds.textContent = String(secondValue).padStart(2, '0');
  };

  render();
  window.setInterval(render, 1000);
});

if (!reduceMotion) {
  const bg = document.querySelector('.lp-interactive-bg');
  window.addEventListener('pointermove', event => {
    if (!bg) return;
    const x = (event.clientX / window.innerWidth - 0.5).toFixed(3);
    const y = (event.clientY / window.innerHeight - 0.5).toFixed(3);
    bg.style.setProperty('--mx', x);
    bg.style.setProperty('--my', y);
    document.documentElement.style.setProperty('--mx', x);
    document.documentElement.style.setProperty('--my', y);
  }, { passive: true });

  window.addEventListener('scroll', () => {
    if (!bg) return;
    bg.style.setProperty('--scroll', String(Math.min(window.scrollY / 1200, 1)));
  }, { passive: true });
}

// Send tracking before leaving for Kiwify checkout.
document.querySelectorAll('a[href="https://pay.kiwify.com.br/U0ynSdt"]').forEach((link, index) => {
  if (!link.dataset.ctaId) {
    link.dataset.ctaId = `ebook_cta_${index + 1}`;
  }

  const checkoutUrl = new URL(link.href);
  const currentParams = new URLSearchParams(window.location.search);
  [
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_content',
    'utm_term',
    'gclid',
    'gbraid',
    'wbraid'
  ].forEach(param => {
    const value = currentParams.get(param);
    if (value && !checkoutUrl.searchParams.has(param)) {
      checkoutUrl.searchParams.set(param, value);
    }
  });
  link.href = checkoutUrl.toString();

  link.addEventListener('click', function(e) {
    e.preventDefault();
    window.trackEbookCheckout?.({
      checkout_provider: 'kiwify',
      cta_id: this.dataset.ctaId || '',
      link_text: this.textContent?.trim() || 'checkout',
      page_location: window.location.href
    });
    window.setTimeout(() => {
      window.location.href = this.href;
    }, 250);
  });
});
</script>

