---
import '../styles/global.css';
import GoogleTag from '../components/GoogleTag.astro';

/*
   CONFIG — Edite aqui todos os dados comerciais da página
*/
const CONFIG = {
  bookTitle: 'Agentes de IA para Negócios',
  subtitle: 'Do entendimento à aplicação real',
  authorBrand: 'Nexora Systems',
  portalBrand: 'Tech Briefing',

  fullPrice: 'R$ 49,90',
  promoPrice: 'R$ 37,00',
  promoLabel: 'Lançamento',

  primaryBuyLink: 'https://pay.kiwify.com.br/U0ynSdt',
  buyLink: 'https://pay.kiwify.com.br/U0ynSdt',

  buyLinks: {
    hotmart: { label: 'Hotmart', url: '#' },
    kiwify: { label: 'Kiwify', url: 'https://pay.kiwify.com.br/U0ynSdt' },
    amazon: { label: 'Amazon Kindle', url: '#' },
    herospark: { label: 'HeroSpark', url: 'https://pay.herospark.com/agentes-de-ia-para-negocios-521255' },
    cacto: { label: 'Cacto', url: '#' },
    clubeAutores: { label: 'Clube dos Autores', url: 'https://clubedeautores.com.br/livro/agentes-de-ia-para-negocios' },
  },

  heroBadge: 'Ebook — Arquitetura & Execução',
  heroHeadline: 'Agentes de IA não são chatbots com nome bonito.',
  heroSub: 'Um guia de 126 páginas para quem quer parar de improvisar com IA e começar a construir sistemas que tomam decisões, executam ações e funcionam sem depender de empurrão humano a cada passo.',

  pages: '126',
  chapters: '12',
  format: 'PDF + EPUB',
  updated: 'Maio 2026',
  language: 'Português',

  guaranteeText: 'Se em 7 dias você sentir que o conteúdo não entregou o que prometeu, devolvemos 100% do valor. Sem perguntas.',

  audienceBullets: [
    { icon: '🏗️', title: 'Fundadores e gestores', desc: 'Que querem entender como agentes funcionam antes de investir — e saber separar o que escala do que é apenas demo.' },
    { icon: '⚙️', title: 'Operadores e analistas', desc: 'Que precisam transformar processos repetitivos em sistemas autônomos com regras claras e limites definidos.' },
    { icon: '🧩', title: 'Consultores e freelancers', desc: 'Que querem oferecer implementação de agentes como serviço — com método, não com improviso.' },
    { icon: '🔬', title: 'Profissionais de tecnologia', desc: 'Que já testaram ferramentas de IA, mas ainda não construíram algo com arquitetura real — que funciona sozinho e melhora com o tempo.' },
    { icon: '📐', title: 'Quem já cansou de demo', desc: 'E quer saber como ir do primeiro teste a uma operação de verdade — com método, não com sorte.' },
  ],

  benefits: [
    'A diferença real entre chatbot, automação e agente — e por que confundir os três custa caro',
    'Os 6 blocos de um agente funcional — e por que nenhum deles é opcional em sistemas reais',
    'Quando usar um agente único e quando investir em multi-agente — sem complicar antes da hora',
    'O framework de 8 passos para criar seu primeiro agente: do problema certo ao deploy com controle',
    'Por que a maioria dos projetos com agentes falha — e os padrões que você precisa evitar desde o início',
    'Como o papel humano muda: de quem executa para quem projeta o que o sistema deve fazer',
    'Como transformar um experimento que funciona às vezes em uma operação que funciona sempre',
    'Um roteiro claro para sair da teoria — com clareza de processo, não com pressa de ferramenta',
  ],

  chapterList: [
    { num: '—', title: 'Introdução', desc: 'Por que agentes de IA são a próxima vantagem competitiva — e por que a maioria ainda não entendeu a mudança.' },
    { num: '01', title: 'O fim da IA como "chat"', desc: 'Como a IA passou de assistente a executor. A diferença entre ajudar a pensar e ajudar a fazer.' },
    { num: '02', title: 'O que são agentes de IA (de verdade)', desc: 'A definição que não quebra depois do hype. O que separa um agente real de um chatbot com nome diferente.' },
    { num: '03', title: 'Cenário real: agente de qualificação', desc: 'Um caso prático completo — do problema à solução — para ver a teoria funcionando.' },
    { num: '04', title: 'Os 6 blocos de um agente moderno', desc: 'Modelo de linguagem, memória, ferramentas, regras e limites, observabilidade e avaliação. Nenhum é opcional.' },
    { num: '05', title: 'Tipos de agentes para negócios', desc: 'Operacional, analítico, de decisão, criativo e coordenador. Como escolher o tipo certo para cada problema.' },
    { num: '06', title: 'Single-agent vs. multi-agent', desc: 'Quando simplificar é estratégia — e quando a complexidade realmente se justifica.' },
    { num: '07', title: 'No-code + IA: construção acessível', desc: 'Por que construir agentes deixou de ser privilégio técnico e passou a depender de clareza de processo.' },
    { num: '08', title: 'Como criar seu primeiro agente', desc: 'O framework de 8 passos: problema, objetivo, fluxo, ferramentas, construção, teste, ajuste e escala.' },
    { num: '09', title: 'Casos reais de agentes em ação', desc: 'Onde agentes já estão gerando resultado — e por que esses casos podem ser replicados.' },
    { num: '10', title: 'Erros comuns e como evitá-los', desc: 'Padrões que comprometem projetos de agentes — e estratégias para não repeti-los.' },
    { num: '11', title: 'O futuro dos negócios com agentes', desc: 'Por que agentes estão deixando de ser diferencial para se tornarem infraestrutura operacional.' },
    { num: '12', title: 'O que muda a partir de agora', desc: 'Uma nova perspectiva sobre trabalho, escala e atenção em um mundo com agentes.' },
  ],

  bonuses: [
    { title: 'Checklist de mapeamento de processos', desc: 'Template prático para identificar onde agentes fazem sentido no seu negócio.' },
    { title: 'Glossário de agentes de IA', desc: '40+ termos explicados de forma direta — sem jargão desnecessário.' },
  ],

  faq: [
    { q: 'Preciso saber programar?', a: 'Não. O ebook cobre desde opções no-code até abordagens com código, mas programação não é pré-requisito. O diferencial está em clareza de processo, não em habilidade técnica.' },
    { q: 'O conteúdo é teórico ou prático?', a: 'Os dois, na medida certa. A teoria existe para construir um modelo mental sólido. Mas cada capítulo avança para frameworks, cenários e passos aplicáveis.' },
    { q: 'O que diferencia este ebook de tutoriais gratuitos?', a: 'Tutoriais ensinam a usar uma ferramenta. Este guia ensina a pensar em sistemas — arquitetura, regras, limites, observabilidade e o papel do humano na operação. É a diferença entre montar uma demo e construir algo que funciona todos os dias.' },
    { q: 'Serve para quem já usa IA no dia a dia?', a: 'Especialmente. Se você já usa ChatGPT ou ferramentas similares, este ebook mostra o próximo nível: sair do chat e entrar na execução operacional com agentes que tomam decisões e executam ações.' },
    { q: 'O conteúdo não fica desatualizado rápido?', a: 'O ebook foca em arquitetura e princípios de design, não em ferramentas específicas. Os 6 blocos, o framework de decisão e o método de construção permanecem válidos independente de qual modelo ou plataforma você usar.' },
    { q: 'O ebook é digital?', a: 'Sim. Você recebe acesso imediato em PDF e EPUB — leia em qualquer dispositivo.' },
    { q: 'Como recebo o acesso?', a: 'Imediatamente após a confirmação do pagamento, por e-mail.' },
    { q: 'Tem versão impressa?', a: 'Sim. Disponível sob demanda pelo Clube dos Autores. A versão digital é entregue imediatamente.' },
    { q: 'Tem garantia?', a: 'Sim. Garantia incondicional de 7 dias. Se não gostar, devolvemos 100%.' },
  ],
};

const title = `${CONFIG.bookTitle} — Ebook por ${CONFIG.authorBrand}`;
const description = 'Arquitetura, regras, observabilidade e execução real: o guia para sair do hype e construir agentes de IA que funcionam no seu negócio. Por Nexora Systems.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const image = '/images/ebook-cover.png';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#121417" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="product" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).toString()} />
  <meta property="og:site_name" content={CONFIG.portalBrand} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Space+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <GoogleTag />
</head>
<body>
<GoogleTag mode="body" />

<!-- TOP BAR -->
<div class="lp-topbar">
  <div class="lp-wrap">
    <a href="/" class="lp-topbar-logo">
      <div class="lp-pip"></div>
      <span>{CONFIG.portalBrand}</span>
    </a>
    <span class="lp-topbar-label">{CONFIG.authorBrand}</span>
  </div>
</div>

<!-- HERO -->
<section class="lp-hero">
  <div class="lp-hero-grid-bg" aria-hidden="true"></div>
  <div class="lp-hero-glow" aria-hidden="true"></div>
  <div class="lp-wrap">
    <div class="lp-hero-layout">
      <div class="lp-hero-content">
        <div class="lp-badge">{CONFIG.heroBadge}</div>
        <h1 class="lp-h1">{CONFIG.heroHeadline}</h1>
        <p class="lp-hero-sub">{CONFIG.heroSub}</p>
        <div class="lp-hero-price">
          <span class="lp-price-old">{CONFIG.fullPrice}</span>
          <span class="lp-price-current">{CONFIG.promoPrice}</span>
          <span class="lp-price-label">{CONFIG.promoLabel}</span>
        </div>
        <div class="lp-hero-actions">
          <a href={CONFIG.primaryBuyLink} class="lp-btn-primary">Garantir meu exemplar →</a>
          <a href="#conteudo" class="lp-btn-ghost">Ver os 12 capítulos</a>
        </div>
        <div class="lp-hero-specs">
          {[`${CONFIG.pages} páginas`, `${CONFIG.chapters} capítulos`, CONFIG.format, CONFIG.language].map(s => (
            <span class="lp-spec"><span class="lp-spec-dot"></span>{s}</span>
          ))}
        </div>
      </div>
      <div class="lp-hero-mockup">
        <div class="lp-book-3d">
          <div class="lp-book-glow" aria-hidden="true"></div>
          <img src="/images/ebook-cover.png" alt="Capa do ebook Agentes de IA para Negócios" class="lp-cover-img" width="380" height="540" />
          <div class="lp-cover-circuit" aria-hidden="true">
            <svg viewBox="0 0 380 540" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="40" cy="80" r="3" fill="#e84393" opacity="0.6"><animate attributeName="opacity" values="0.3;0.8;0.3" dur="3s" repeatCount="indefinite"/></circle>
              <circle cx="340" cy="120" r="2.5" fill="#e84393" opacity="0.4"><animate attributeName="opacity" values="0.2;0.7;0.2" dur="4s" repeatCount="indefinite"/></circle>
              <circle cx="60" cy="460" r="2" fill="#e84393" opacity="0.5"><animate attributeName="opacity" values="0.3;0.9;0.3" dur="2.5s" repeatCount="indefinite"/></circle>
              <path d="M40,80 L120,80 L120,140" stroke="#e84393" stroke-width="0.8" opacity="0.25"><animate attributeName="opacity" values="0.1;0.4;0.1" dur="3s" repeatCount="indefinite"/></path>
              <path d="M340,120 L280,120 L280,200" stroke="#e84393" stroke-width="0.8" opacity="0.2"><animate attributeName="opacity" values="0.1;0.35;0.1" dur="4s" repeatCount="indefinite"/></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TRUST STRIP -->
<div class="lp-trust">
  <div class="lp-wrap">
    <div class="lp-trust-inner">
      {[
        { ico: '📐', label: 'Arquitetura real de agentes' },
        { ico: '⚡', label: 'Acesso imediato' },
        { ico: '🔒', label: 'Pagamento seguro' },
        { ico: '🔄', label: 'Garantia de 7 dias' },
        { ico: '🇧🇷', label: 'Conteúdo em português' },
      ].map(t => (
        <div class="lp-trust-item">
          <span class="lp-trust-ico">{t.ico}</span>
          <span>{t.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- O PROBLEMA -->
<section class="lp-section" style="position:relative;overflow:hidden">
  <div class="lp-circuit-bg" aria-hidden="true">
    <svg width="100%" height="100%" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
      <line x1="0" y1="200" x2="200" y2="200" stroke="oklch(0.80 0.14 62/.08)" stroke-width="1"/><line x1="200" y1="200" x2="200" y2="400" stroke="oklch(0.80 0.14 62/.08)" stroke-width="1"/>
      <line x1="1000" y1="100" x2="1200" y2="100" stroke="oklch(0.80 0.14 62/.06)" stroke-width="1"/><line x1="1000" y1="100" x2="1000" y2="350" stroke="oklch(0.80 0.14 62/.06)" stroke-width="1"/>
      <circle cx="200" cy="200" r="4" fill="oklch(0.80 0.14 62/.15)"><animate attributeName="r" values="3;6;3" dur="4s" repeatCount="indefinite"/></circle>
      <circle cx="1000" cy="100" r="3" fill="oklch(0.80 0.14 62/.12)"><animate attributeName="r" values="2;5;2" dur="5s" repeatCount="indefinite"/></circle>
      <circle cx="1000" cy="350" r="3" fill="oklch(0.80 0.14 62/.1)"><animate attributeName="r" values="2;4;2" dur="3.5s" repeatCount="indefinite"/></circle>
    </svg>
  </div>
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">01</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">O problema</span>
    </div>
    <h2 class="lp-h2">Quando tudo vira "agente", o termo <em>deixa de explicar.</em></h2>
    <div class="lp-problem-grid">
      {[
        { label: 'O hype', desc: 'Chatbots com instruções mais longas, automações com um webhook no meio e scripts com nome bonito — tudo virou "agente de IA".' },
        { label: 'A confusão', desc: 'Sem uma definição clara, você não sabe se está construindo algo que escala ou apenas criando versões mais rápidas do mesmo trabalho.' },
        { label: 'O custo', desc: 'Ferramentas erradas, arquitetura improvisada, agentes sem observabilidade — cada erro se multiplica quando você tenta escalar.' },
      ].map(p => (
        <div class="lp-problem-card">
          <div class="lp-problem-label">{p.label}</div>
          <div class="lp-problem-desc">{p.desc}</div>
        </div>
      ))}
    </div>
    <div class="lp-problem-pivot">
      <p>Este ebook existe para resolver isso. Para dar a você uma definição que não quebra depois do hype, uma arquitetura que funciona em produção e um método para sair da curiosidade e entrar na execução.</p>
    </div>
  </div>
</section>

<!-- PARA QUEM É -->
<section class="lp-section lp-section-alt">
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">02</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">Para quem é</span>
    </div>
    <h2 class="lp-h2">Para quem quer construir, <em>não só consumir.</em></h2>
    <div class="lp-audience-grid">
      {CONFIG.audienceBullets.map(a => (
        <div class="lp-audience-card">
          <div class="lp-audience-ico">{a.icon}</div>
          <div class="lp-audience-title">{a.title}</div>
          <div class="lp-audience-desc">{a.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- O QUE VOCÊ VAI APRENDER -->
<section class="lp-section" id="aprender">
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">03</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">O que você vai aprender</span>
    </div>
    <h2 class="lp-h2">Um modelo mental completo. <em>Um método para executar.</em></h2>
    <div class="lp-benefits-grid">
      {CONFIG.benefits.map(b => (
        <div class="lp-benefit-row">
          <span class="lp-benefit-check">✓</span>
          <span>{b}</span>
        </div>
      ))}
    </div>
    <div class="lp-cta-mid">
      <a href={CONFIG.primaryBuyLink} class="lp-btn-primary">Quero esse ebook →</a>
    </div>
  </div>
</section>

<!-- DIFERENCIAL: OS 6 BLOCOS -->
<section class="lp-section lp-section-alt" style="position:relative;overflow:hidden">
  <div class="lp-neural-bg" aria-hidden="true">
    <svg width="100%" height="100%" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.12">
        <circle cx="150" cy="200" r="40" stroke="oklch(0.80 0.14 62)" stroke-width="0.5" fill="none"/><circle cx="150" cy="200" r="5" fill="oklch(0.80 0.14 62/.3)"><animate attributeName="r" values="4;7;4" dur="3s" repeatCount="indefinite"/></circle>
        <circle cx="400" cy="100" r="30" stroke="oklch(0.80 0.14 62)" stroke-width="0.5" fill="none"/><circle cx="400" cy="100" r="4" fill="oklch(0.80 0.14 62/.25)"/>
        <circle cx="350" cy="350" r="35" stroke="oklch(0.80 0.14 62)" stroke-width="0.5" fill="none"/><circle cx="350" cy="350" r="4" fill="oklch(0.80 0.14 62/.2)"/>
        <circle cx="850" cy="150" r="45" stroke="oklch(0.80 0.14 62)" stroke-width="0.5" fill="none"/><circle cx="850" cy="150" r="5" fill="oklch(0.80 0.14 62/.2)"><animate attributeName="r" values="3;6;3" dur="4s" repeatCount="indefinite"/></circle>
        <circle cx="1050" cy="400" r="30" stroke="oklch(0.80 0.14 62)" stroke-width="0.5" fill="none"/><circle cx="1050" cy="400" r="4" fill="oklch(0.80 0.14 62/.2)"/>
        <circle cx="600" cy="600" r="25" stroke="oklch(0.80 0.14 62)" stroke-width="0.5" fill="none"/>
        <line x1="150" y1="200" x2="400" y2="100" stroke="oklch(0.80 0.14 62)" stroke-width="0.4"/><line x1="150" y1="200" x2="350" y2="350" stroke="oklch(0.80 0.14 62)" stroke-width="0.4"/>
        <line x1="400" y1="100" x2="850" y2="150" stroke="oklch(0.80 0.14 62)" stroke-width="0.4"/><line x1="350" y1="350" x2="600" y2="600" stroke="oklch(0.80 0.14 62)" stroke-width="0.4"/>
        <line x1="850" y1="150" x2="1050" y2="400" stroke="oklch(0.80 0.14 62)" stroke-width="0.4"/><line x1="1050" y1="400" x2="600" y2="600" stroke="oklch(0.80 0.14 62)" stroke-width="0.3"/>
      </g>
    </svg>
  </div>
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">04</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">Dentro do ebook</span>
    </div>
    <h2 class="lp-h2">Os 6 blocos que todo agente funcional <em>precisa ter.</em></h2>
    <p class="lp-section-intro">A partir desse ponto, você deixa de montar fluxos de forma intuitiva e começa a desenhar arquitetura. É o que separa um agente que funciona de um que parece funcionar.</p>
    <div class="lp-blocks-grid">
      {[
        { num: '01', title: 'Modelo de linguagem', desc: 'O cérebro que toma decisões. Não é só GPT — é entender qual modelo serve para qual função.' },
        { num: '02', title: 'Memória', desc: 'O que impede o sistema de começar do zero toda vez. Contexto persistente que melhora com o uso.' },
        { num: '03', title: 'Ferramentas', desc: 'Onde a IA deixa de falar e começa a agir. APIs, integrações e ações no mundo real.' },
        { num: '04', title: 'Regras e limites', desc: 'O que torna o sistema confiável. Permissões, segurança e limites definidos por humanos.' },
        { num: '05', title: 'Observabilidade', desc: 'Enxergar o que está acontecendo. Sem isso, você não sabe se o agente funciona ou apenas parece funcionar.' },
        { num: '06', title: 'Avaliação', desc: 'Onde o sistema deixa de ser experimento. Métricas reais que permitem evolução contínua.' },
      ].map(b => (
        <div class="lp-block-card">
          <div class="lp-block-num">{b.num}</div>
          <div class="lp-block-title">{b.title}</div>
          <div class="lp-block-desc">{b.desc}</div>
        </div>
      ))}
    </div>
    <p class="lp-blocks-quote">Cada um resolve um problema específico. Nenhum é opcional em sistemas reais.</p>
  </div>
</section>

<!-- TRANSFORMACAO: O PAPEL HUMANO -->
<section class="lp-section" style="position:relative;overflow:hidden">
  <div class="lp-flow-bg" aria-hidden="true">
    <svg width="100%" height="100%" viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,250 Q300,100 600,250 T1200,250" stroke="oklch(0.80 0.14 62/.08)" stroke-width="1.5" fill="none"/>
      <path d="M0,300 Q300,150 600,300 T1200,300" stroke="oklch(0.80 0.14 62/.05)" stroke-width="1" fill="none"/>
      <circle r="4" fill="oklch(0.80 0.14 62/.3)"><animateMotion dur="8s" repeatCount="indefinite" path="M0,250 Q300,100 600,250 T1200,250"/></circle>
      <circle r="3" fill="oklch(0.80 0.14 62/.2)"><animateMotion dur="10s" repeatCount="indefinite" path="M0,300 Q300,150 600,300 T1200,300"/></circle>
    </svg>
  </div>
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">05</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">A mudança de papel</span>
    </div>
    <h2 class="lp-h2">O humano não sai do sistema. <em>Ele muda de posição.</em></h2>
    <div class="lp-roles-grid">
      {[
        { phase: 'Fase 1', role: 'Executor', desc: 'Realiza tarefas passo a passo. É onde a maioria ainda está.' },
        { phase: 'Fase 2', role: 'Supervisor', desc: 'Monitora agentes e ajusta regras. O sistema executa, o humano valida.' },
