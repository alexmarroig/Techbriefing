---
import '../styles/global.css';
import GoogleTag from '../components/GoogleTag.astro';

/*
   CONFIG — Edite aqui todos os dados comerciais da página
*/
const CONFIG = {
  bookTitle: 'Agentes de IA para Negócios',
  subtitle: 'Do entendimento à aplicação real',
  authorBrand: 'Nexora Systems',
  portalBrand: 'Tech Briefing',
  portalTagline: 'IA aplicada para negócios reais',

  fullPrice: 'R$ 49,90',
  promoPrice: 'R$ 37,00',
  promoLabel: 'Lançamento',
  promoEndIso: '2026-05-14T23:59:00-03:00',

  primaryBuyLink: 'https://pay.kiwify.com.br/U0ynSdt',
  buyLink: 'https://pay.kiwify.com.br/U0ynSdt',

  buyLinks: {
    hotmart: { label: 'Hotmart', url: 'https://pay.kiwify.com.br/U0ynSdt' },
    kiwify: { label: 'Kiwify', url: 'https://pay.kiwify.com.br/U0ynSdt' },
    amazon: { label: 'Amazon Kindle', url: 'https://pay.kiwify.com.br/U0ynSdt' },
    herospark: { label: 'HeroSpark', url: 'https://pay.herospark.com/agentes-de-ia-para-negocios-521255' },
    cacto: { label: 'Cacto', url: 'https://pay.kiwify.com.br/U0ynSdt' },
    clubeAutores: { label: 'Clube dos Autores', url: 'https://clubedeautores.com.br/livro/agentes-de-ia-para-negocios' },
  },

  heroBadge: 'Oferta de lançamento - acesso imediato',
  heroHeadline: 'Pare de brincar com IA. Comece a transformar IA em dinheiro, tempo e operação.',
  heroSub: 'Um guia direto para quem usa ChatGPT, automações e ferramentas de IA, mas ainda não sabe transformar isso em processos reais, agentes úteis e ofertas que clientes entendem e compram.',

  pages: '126',
  chapters: '12',
  format: 'PDF + EPUB',
  updated: 'Maio 2026',
  language: 'Português',

  guaranteeText: 'Se em 7 dias você sentir que o conteúdo não entregou o que prometeu, devolvemos 100% do valor. Sem perguntas.',

  painPoints: [
    { label: 'Você pede ajuda para a IA, mas o trabalho volta para você', desc: 'A IA responde. Só que quem copia, cola, revisa, envia, cobra e acompanha ainda é você.' },
    { label: 'Automação fraca parece lucro, mas vira retrabalho', desc: 'Um campo diferente, um lead incompleto ou uma exceção simples já derruba o fluxo inteiro.' },
    { label: 'Você vê oportunidade, mas não sabe o que vender', desc: 'Sem mapa de processo, vira tentativa aleatória: muita ferramenta, pouca proposta comercial.' },
    { label: 'Você quer cobrar por IA, mas tem medo de entregar mal', desc: 'Sem arquitetura, limite e avaliação, qualquer projeto parece bonito na demo e perigoso no cliente real.' },
  ],

  outcomes: [
    { title: 'Encontrar processos com potencial real', desc: 'Você aprende a separar tarefas que merecem agente daquelas que só precisam de uma automação simples.' },
    { title: 'Desenhar um agente antes da ferramenta', desc: 'Objetivo, entradas, regras, memória, ferramentas, limites e métrica ficam claros antes de abrir qualquer plataforma.' },
    { title: 'Evitar erros caros de implementação', desc: 'Você entende por que projetos falham: falta de observabilidade, escopo frouxo, ação sem permissão e testes ruins.' },
    { title: 'Cobrar melhor por projetos de IA', desc: 'Use o método para transformar agentes em entrega consultiva, com escopo mais claro e menos promessa vazia.' },
  ],

  audienceBullets: [
    { icon: '01', title: 'Empreendedores sem tempo para errar', desc: 'Você quer usar IA para vender, atender, produzir ou operar melhor, mas não pode desperdiçar semanas em ferramenta errada.' },
    { icon: '02', title: 'Consultores e freelancers que querem cobrar por IA', desc: 'Você quer vender agentes de IA como serviço, com método claro para diagnosticar, desenhar e entregar projetos.' },
    { icon: '03', title: 'Gestores e operadores', desc: 'Você vive apagando incêndio em tarefas repetitivas e precisa transformar processo manual em sistema confiável.' },
    { icon: '04', title: 'Quem já testou IA e travou', desc: 'Você sabe que existe oportunidade, mas ainda não conseguiu sair da conversa com o chat para uma operação de verdade.' },
  ],

  benefits: [
    'Descobrir quais tarefas merecem um agente e quais só precisam de automação simples',
    'Montar a arquitetura mínima de um agente: objetivo, memória, ferramentas, regras e avaliação',
    'Saber explicar para um cliente por que aquilo vale dinheiro e não é só “um chatbot”',
    'Mapear processos de vendas, suporte, conteúdo e operação que podem virar entrega real',
    'Evitar projetos bonitos na demo, mas frágeis quando entram no negócio de verdade',
    'Definir limites humanos para o agente agir sem colocar sua reputação em risco',
    'Criar uma oferta mais clara para vender IA sem depender de promessa vaga',
    'Seguir um roteiro de 8 passos para construir seu primeiro agente com método',
  ],

  chapterList: [
    { num: '—', title: 'Introdução', desc: 'Por que agentes de IA são a próxima vantagem competitiva — e por que a maioria ainda não entendeu a mudança.' },
    { num: '01', title: 'O fim da IA como "chat"', desc: 'Como a IA passou de assistente a executor. A diferença entre ajudar a pensar e ajudar a fazer.' },
    { num: '02', title: 'O que são agentes de IA (de verdade)', desc: 'A definição que não quebra depois do hype. O que separa um agente real de um chatbot com nome diferente.' },
    { num: '03', title: 'Cenário real: agente de qualificação', desc: 'Um caso prático completo — do problema à solução — para ver a teoria funcionando.' },
    { num: '04', title: 'Os 6 blocos de um agente moderno', desc: 'Modelo de linguagem, memória, ferramentas, regras e limites, observabilidade e avaliação. Nenhum é opcional.' },
    { num: '05', title: 'Tipos de agentes para negócios', desc: 'Operacional, analítico, de decisão, criativo e coordenador. Como escolher o tipo certo para cada problema.' },
    { num: '06', title: 'Single-agent vs. multi-agent', desc: 'Quando simplificar é estratégia — e quando a complexidade realmente se justifica.' },
    { num: '07', title: 'No-code + IA: construção acessível', desc: 'Por que construir agentes deixou de ser privilégio técnico e passou a depender de clareza de processo.' },
    { num: '08', title: 'Como criar seu primeiro agente', desc: 'O framework de 8 passos: problema, objetivo, fluxo, ferramentas, construção, teste, ajuste e escala.' },
    { num: '09', title: 'Casos reais de agentes em ação', desc: 'Onde agentes já estão gerando resultado — e por que esses casos podem ser replicados.' },
    { num: '10', title: 'Erros comuns e como evitá-los', desc: 'Padrões que comprometem projetos de agentes — e estratégias para não repeti-los.' },
    { num: '11', title: 'O futuro dos negócios com agentes', desc: 'Por que agentes estão deixando de ser diferencial para se tornarem infraestrutura operacional.' },
    { num: '12', title: 'O que muda a partir de agora', desc: 'Uma nova perspectiva sobre trabalho, escala e atenção em um mundo com agentes.' },
  ],

  bonuses: [
    { title: 'Checklist de mapeamento de processos', desc: 'Template prático para identificar onde agentes fazem sentido no seu negócio.' },
    { title: 'Glossário de agentes de IA', desc: '40+ termos explicados de forma direta — sem jargão desnecessário.' },
  ],

  faq: [
    { q: 'Preciso saber programar?', a: 'Não. O ebook cobre desde opções no-code até abordagens com código, mas programação não é pré-requisito. O diferencial está em clareza de processo, não em habilidade técnica.' },
    { q: 'O conteúdo é teórico ou prático?', a: 'Os dois, na medida certa. A teoria existe para construir um modelo mental sólido. Mas cada capítulo avança para frameworks, cenários e passos aplicáveis.' },
    { q: 'O que diferencia este ebook de tutoriais gratuitos?', a: 'Tutoriais ensinam a usar uma ferramenta. Este guia ensina a pensar em sistemas — arquitetura, regras, limites, observabilidade e o papel do humano na operação. É a diferença entre montar uma demo e construir algo que funciona todos os dias.' },
    { q: 'Serve para quem já usa IA no dia a dia?', a: 'Especialmente. Se você já usa ChatGPT ou ferramentas similares, este ebook mostra o próximo nível: sair do chat e entrar na execução operacional com agentes que tomam decisões e executam ações.' },
    { q: 'O conteúdo não fica desatualizado rápido?', a: 'O ebook foca em arquitetura e princípios de design, não em ferramentas específicas. Os 6 blocos, o framework de decisão e o método de construção permanecem válidos independente de qual modelo ou plataforma você usar.' },
    { q: 'O ebook é digital?', a: 'Sim. Você recebe acesso imediato em PDF e EPUB — leia em qualquer dispositivo.' },
    { q: 'Como recebo o acesso?', a: 'Imediatamente após a confirmação do pagamento, por e-mail.' },
    { q: 'Tem versão impressa?', a: 'Sim. Disponível sob demanda pelo Clube dos Autores. A versão digital é entregue imediatamente.' },
    { q: 'Tem garantia?', a: 'Sim. Garantia incondicional de 7 dias. Se não gostar, devolvemos 100%.' },
  ],
};

const title = `${CONFIG.bookTitle} — Ebook por ${CONFIG.authorBrand}`;
const description = 'Arquitetura, regras, observabilidade e execução real: o guia para sair do hype e construir agentes de IA que funcionam no seu negócio. Por Nexora Systems.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const image = '/images/ebook-cover.png';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#121417" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="product" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).toString()} />
  <meta property="og:site_name" content={CONFIG.portalBrand} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Space+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <GoogleTag />
</head>
<body>
<GoogleTag mode="body" />
<div class="lp-interactive-bg" aria-hidden="true">
  <div class="lp-orbit lp-orbit-a"></div>
  <div class="lp-orbit lp-orbit-b"></div>
  <div class="lp-orbit lp-orbit-c"></div>
</div>

<!-- TOP BAR -->
<div class="lp-topbar">
  <div class="lp-wrap">
    <a href="/" class="lp-topbar-logo">
      <div class="lp-brand-mark" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <span class="lp-brand-word">{CONFIG.portalBrand}</span>
      <span class="lp-brand-sub">{CONFIG.portalTagline}</span>
    </a>
    <a href="#oferta" class="lp-topbar-cta">Garantir R$ 37</a>
  </div>
</div>

<!-- HERO -->
<section class="lp-hero">
  <div class="lp-hero-grid-bg" aria-hidden="true"></div>
  <div class="lp-hero-glow" aria-hidden="true"></div>
  <div class="lp-wrap">
    <div class="lp-hero-layout">
      <div class="lp-hero-content">
        <div class="lp-badge">{CONFIG.heroBadge}</div>
        <h1 class="lp-h1">{CONFIG.heroHeadline}</h1>
        <p class="lp-hero-sub">{CONFIG.heroSub}</p>
        <div class="lp-urgency-card" data-promo-end={CONFIG.promoEndIso}>
          <div>
            <span class="lp-urgency-kicker">Promoção imperdível</span>
            <strong>R$ 37 somente no lançamento</strong>
            <span class="lp-urgency-note">Depois, o ebook volta para {CONFIG.fullPrice}.</span>
          </div>
          <div class="lp-countdown" aria-label="Tempo restante da promoção">
            <span><b data-countdown-days>00</b><small>Dias</small></span>
            <span><b data-countdown-hours>00</b><small>Horas</small></span>
            <span><b data-countdown-minutes>00</b><small>Min</small></span>
            <span><b data-countdown-seconds>00</b><small>Seg</small></span>
          </div>
        </div>
        <div class="lp-hero-price">
          <span class="lp-price-old">{CONFIG.fullPrice}</span>
          <span class="lp-price-current">{CONFIG.promoPrice}</span>
          <span class="lp-price-label">{CONFIG.promoLabel}</span>
        </div>
        <div class="lp-hero-actions">
          <a href={CONFIG.primaryBuyLink} class="lp-btn-primary">Garantir por R$ 37 agora →</a>
          <a href="#conteudo" class="lp-btn-ghost">Ver os 12 capítulos</a>
        </div>
        <div class="lp-fast-trust" aria-label="Sinais de segurança">
          <span>Compra segura</span>
          <span>Acesso imediato</span>
          <span>7 dias de garantia</span>
        </div>
        <div class="lp-hero-specs">
          {[`${CONFIG.pages} páginas`, `${CONFIG.chapters} capítulos`, CONFIG.format, CONFIG.language].map(s => (
            <span class="lp-spec"><span class="lp-spec-dot"></span>{s}</span>
          ))}
        </div>
      </div>
      <div class="lp-hero-mockup">
        <div class="lp-book-3d">
          <div class="lp-book-glow" aria-hidden="true"></div>
          <img src="/images/ebook-cover.png" alt="Capa do ebook Agentes de IA para Negócios" class="lp-cover-img" width="380" height="540" />
          <div class="lp-cover-circuit" aria-hidden="true">
            <svg viewBox="0 0 380 540" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="40" cy="80" r="3" fill="#e84393" opacity="0.6"><animate attributeName="opacity" values="0.3;0.8;0.3" dur="3s" repeatCount="indefinite"/></circle>
              <circle cx="340" cy="120" r="2.5" fill="#e84393" opacity="0.4"><animate attributeName="opacity" values="0.2;0.7;0.2" dur="4s" repeatCount="indefinite"/></circle>
              <circle cx="60" cy="460" r="2" fill="#e84393" opacity="0.5"><animate attributeName="opacity" values="0.3;0.9;0.3" dur="2.5s" repeatCount="indefinite"/></circle>
              <path d="M40,80 L120,80 L120,140" stroke="#e84393" stroke-width="0.8" opacity="0.25"><animate attributeName="opacity" values="0.1;0.4;0.1" dur="3s" repeatCount="indefinite"/></path>
              <path d="M340,120 L280,120 L280,200" stroke="#e84393" stroke-width="0.8" opacity="0.2"><animate attributeName="opacity" values="0.1;0.35;0.1" dur="4s" repeatCount="indefinite"/></path>
            </svg>
          </div>
        </div>
        <div class="lp-hero-proof">
          <strong>Para quem quer vender, atender ou operar com agentes.</strong>
          <span>Sem depender de tentativa, hype ou promessa vazia.</span>
        </div>
        <div class="lp-checkout-card" aria-label="Resumo da compra">
          <div class="lp-checkout-kicker">Resumo da compra</div>
          <div class="lp-checkout-product">
            <img src="/images/ebook-cover.png" alt="" width="48" height="68" />
            <div>
              <strong>Agentes de IA para Negócios</strong>
              <span>PDF + EPUB • acesso imediato</span>
            </div>
          </div>
          <div class="lp-checkout-row"><span>Preço promocional</span><strong>R$ 37,00</strong></div>
          <div class="lp-checkout-row"><span>Garantia</span><strong>7 dias</strong></div>
          <a href={CONFIG.primaryBuyLink} class="lp-btn-primary lp-btn-full">Comprar agora →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TRUST STRIP -->
<div class="lp-trust">
  <div class="lp-wrap">
    <div class="lp-trust-inner">
      {[
        { ico: 'PDF', label: 'PDF + EPUB' },
        { ico: '24H', label: 'Acesso imediato' },
        { ico: 'SSL', label: 'Pagamento seguro' },
        { ico: '7D', label: 'Garantia de 7 dias' },
        { ico: 'BR', label: 'Conteúdo em português' },
      ].map(t => (
        <div class="lp-trust-item">
          <span class="lp-trust-ico">{t.ico}</span>
          <span>{t.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- O PROBLEMA -->
<section class="lp-section" style="position:relative;overflow:hidden">
  <div class="lp-circuit-bg" aria-hidden="true">
    <svg width="100%" height="100%" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
      <line x1="0" y1="200" x2="200" y2="200" stroke="oklch(0.80 0.14 62/.08)" stroke-width="1"/><line x1="200" y1="200" x2="200" y2="400" stroke="oklch(0.80 0.14 62/.08)" stroke-width="1"/>
      <line x1="1000" y1="100" x2="1200" y2="100" stroke="oklch(0.80 0.14 62/.06)" stroke-width="1"/><line x1="1000" y1="100" x2="1000" y2="350" stroke="oklch(0.80 0.14 62/.06)" stroke-width="1"/>
      <circle cx="200" cy="200" r="4" fill="oklch(0.80 0.14 62/.15)"><animate attributeName="r" values="3;6;3" dur="4s" repeatCount="indefinite"/></circle>
      <circle cx="1000" cy="100" r="3" fill="oklch(0.80 0.14 62/.12)"><animate attributeName="r" values="2;5;2" dur="5s" repeatCount="indefinite"/></circle>
      <circle cx="1000" cy="350" r="3" fill="oklch(0.80 0.14 62/.1)"><animate attributeName="r" values="2;4;2" dur="3.5s" repeatCount="indefinite"/></circle>
    </svg>
  </div>
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">01</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">O problema</span>
    </div>
    <h2 class="lp-h2">A dor não é falta de IA. É usar IA e continuar preso no trabalho manual.</h2>
    <div class="lp-problem-grid">
      {CONFIG.painPoints.map(p => (
        <div class="lp-problem-card">
          <div class="lp-problem-label">{p.label}</div>
          <div class="lp-problem-desc">{p.desc}</div>
        </div>
      ))}
    </div>
    <div class="lp-problem-pivot">
      <p>Este ebook foi feito para trocar improviso por arquitetura. Você entende onde agentes fazem sentido, como desenhar o fluxo e como evitar o tipo de projeto que parece inteligente, mas não entrega resultado.</p>
      <a href={CONFIG.primaryBuyLink} class="lp-inline-cta">Quero parar de improvisar →</a>
    </div>
  </div>
</section>

<!-- RESULTADOS -->
<section class="lp-section lp-section-outcomes">
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">02</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">Benefícios práticos</span>
    </div>
    <h2 class="lp-h2">O que você vai conseguir fazer depois de ler.</h2>
    <p class="lp-section-intro">A promessa é simples: sair do consumo infinito de conteúdo sobre IA e ganhar um mapa prático para construir, vender ou implementar agentes com mais segurança.</p>
    <div class="lp-outcomes-grid">
      {CONFIG.outcomes.map((o, index) => (
        <div class="lp-outcome-card">
          <span class="lp-outcome-num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{o.title}</h3>
          <p>{o.desc}</p>
        </div>
      ))}
    </div>
    <div class="lp-cta-mid">
      <a href={CONFIG.primaryBuyLink} class="lp-btn-primary">Quero sair do improviso por R$ 37 →</a>
    </div>
  </div>
</section>

<!-- PARA QUEM É -->
<section class="lp-section lp-section-alt">
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">03</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">Para quem está travado</span>
    </div>
    <h2 class="lp-h2">Para quem quer transformar interesse em IA em uma vantagem real.</h2>
    <div class="lp-audience-grid">
      {CONFIG.audienceBullets.map(a => (
        <div class="lp-audience-card">
          <div class="lp-audience-ico">{a.icon}</div>
          <div class="lp-audience-title">{a.title}</div>
          <div class="lp-audience-desc">{a.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- O QUE VOCÊ VAI APRENDER -->
<section class="lp-section" id="aprender">
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">04</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">O que você vai aprender</span>
    </div>
    <h2 class="lp-h2">Menos teoria solta. Mais clareza para executar.</h2>
    <div class="lp-benefits-grid">
      {CONFIG.benefits.map(b => (
        <div class="lp-benefit-row">
          <span class="lp-benefit-check">✓</span>
          <span>{b}</span>
        </div>
      ))}
    </div>
    <div class="lp-cta-mid">
      <a href={CONFIG.primaryBuyLink} class="lp-btn-primary">Comprar com acesso imediato →</a>
    </div>
  </div>
</section>

<!-- VALUE PROOF -->
<section class="lp-section lp-proof-section" id="preview">
  <div class="lp-wrap">
    <div class="lp-section-header">
      <span class="lp-section-num">05</span>
      <div class="lp-section-rule"></div>
      <span class="lp-section-label">Para cobrar melhor</span>
    </div>
    <div class="lp-proof-layout">
      <div>
        <h2 class="lp-h2">Não venda “prompt”. Venda processo, automação e resultado.</h2>
        <p class="lp-section-intro">Cliente não paga mais porque você sabe usar uma ferramenta. Cliente paga quando entende que você consegue tirar uma tarefa repetitiva da mão dele, reduzir erro e criar uma operação mais leve.</p>
        <div class="lp-proof-points">
          <span>Diagnóstico claro</span>
          <span>Escopo defendável</span>
          <span>Entrega com método</span>
        </div>
        <a href={CONFIG.primaryBuyLink} class="lp-btn-primary">Quero cobrar por IA com mais clareza →</a>
      </div>
      <div class="lp-proof-board" aria-label="Resumo do valor do ebook">
        <div class="lp-proof-card lp-proof-card-hot">
          <span>Antes</span>
          <strong>Você entrega conversa com IA.</strong>
          <p>O cliente acha interessante, mas não enxerga operação, economia ou retorno.</p>
