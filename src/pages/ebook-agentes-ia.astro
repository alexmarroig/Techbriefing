  height: 34px;
  border: 1px solid oklch(0.80 0.14 62 / 0.35);
  border-radius: 10px;
  background:
    radial-gradient(circle at 72% 26%, oklch(0.80 0.14 62 / 0.28), transparent 42%),
    oklch(0.06 0.006 240 / 0.92);
  display: grid;
  place-items: center;
  box-shadow: 0 0 28px oklch(0.80 0.14 62 / 0.12);
}
.lp-brand-mark span:first-child {
  width: 16px;
  height: 16px;
  border-left: 2px solid var(--amber);
  border-bottom: 2px solid var(--amber);
  transform: rotate(-45deg);
}
.lp-brand-mark span:last-child {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--amber);
  box-shadow: 0 0 12px var(--amber);
}
.lp-brand-word {
  font-family: var(--serif);
  font-size: 21px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
}
.lp-brand-sub,
.lp-topbar-cta {
  font-family: var(--mono); font-size: 10.5px; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3);
}
.lp-topbar-cta {
  color: oklch(0.08 0.006 240);
  background: var(--amber);
  border-radius: 999px;
  padding: 10px 14px;
  font-weight: 800;
  box-shadow: 0 12px 34px oklch(0.80 0.14 62 / 0.18);
}
.lp-pip {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--amber);
  box-shadow: 0 0 10px var(--amber), 0 0 20px oklch(0.80 0.14 62 / 0.4);
}

/* Hero */
.lp-hero {
  position: relative; overflow: hidden;
  padding: 72px 0 64px;
}
.lp-hero-grid-bg {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(oklch(0.22 0.01 240 / 0.35) 1px, transparent 1px),
    linear-gradient(90deg, oklch(0.22 0.01 240 / 0.35) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: radial-gradient(ellipse 90% 100% at 50% 0%, black 0%, transparent 100%);
}
.lp-hero-glow {
  position: absolute; top: -300px; left: 50%; transform: translateX(-50%);
  width: 1000px; height: 700px; border-radius: 50%;
  background: radial-gradient(ellipse, oklch(0.80 0.14 62 / 0.06) 0%, transparent 65%);
  pointer-events: none;
}
.lp-hero-layout {
  display: grid; grid-template-columns: minmax(0, 1fr) 390px; gap: 70px; align-items: center;
  position: relative; z-index: 1;
}
@media(max-width:900px){
  .lp-hero-layout { grid-template-columns: 1fr; gap: 36px; }
  .lp-hero-mockup { order: -1; display: grid; justify-items: center; }
  .lp-hero { padding: 64px 0 56px; }
}
.lp-badge {
  display: inline-block;
  font-family: var(--mono); font-size: 10.5px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase;
  padding: 5px 14px; border-radius: 100px;
  border: 1px solid var(--amber-d); color: var(--amber);
  margin-bottom: 24px;
}
.lp-h1 {
  font-family: var(--serif);
  font-size: clamp(46px, 5.7vw, 76px);
  font-weight: 800; line-height: 0.97;
  letter-spacing: -0.035em;
  margin-bottom: 20px;
  max-width: 690px;
  text-wrap: balance;
  text-shadow:
    0 0 34px oklch(0.80 0.14 62 / 0.10),
    0 18px 70px oklch(0 0 0 / 0.42);
}
.lp-hero-sub {
  font-size: 18px; line-height: 1.55;
  color: var(--text); font-weight: 500;
  max-width: 620px; margin-bottom: 24px;
  text-wrap: pretty;
}
.lp-hero-sub::first-letter {
  color: var(--amber);
}
.lp-urgency-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18px;
  align-items: center;
  max-width: 620px;
  margin: 0 0 20px;
  padding: 14px;
  border: 1px solid oklch(0.80 0.14 62 / 0.35);
  border-radius: 16px;
  background:
    linear-gradient(135deg, oklch(0.80 0.14 62 / 0.12), oklch(0.72 0.18 338 / 0.08)),
    oklch(0.10 0.01 240 / 0.82);
  box-shadow: 0 22px 70px oklch(0 0 0 / 0.28);
}
.lp-urgency-kicker,
.lp-urgency-note {
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--amber);
}
.lp-urgency-card strong {
  display: block;
  margin: 4px 0 6px;
  font-family: var(--serif);
  font-size: 28px;
  line-height: 1.05;
  letter-spacing: -0.035em;
  color: var(--text);
  text-shadow: 0 0 28px oklch(0.80 0.14 62 / 0.15);
}
.lp-urgency-note {
  color: var(--text-3);
  letter-spacing: 0.04em;
  text-transform: none;
}
.lp-countdown {
  display: flex;
  gap: 8px;
}
.lp-countdown span {
  min-width: 58px;
  padding: 11px 8px 9px;
  border-radius: 12px;
  background: oklch(0.06 0.006 240 / 0.88);
  border: 1px solid oklch(0.80 0.14 62 / 0.22);
  text-align: center;
  box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.05), 0 8px 24px oklch(0 0 0 / 0.22);
}
.lp-countdown b {
  display: block;
  font-family: var(--mono);
  font-size: 21px;
  color: var(--amber);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.lp-countdown small {
  display: block;
  margin-top: 2px;
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-4);
}
.lp-urgency-card.is-expired {
  border-color: var(--line);
}
.lp-hero-price {
  display: flex; align-items: baseline; gap: 12px;
  margin-bottom: 20px;
}
.lp-price-old {
  font-family: var(--mono); font-size: 15px;
  color: var(--text-4); text-decoration: line-through;
}
.lp-price-current {
  font-family: var(--serif); font-size: 40px;
  font-weight: 700; color: var(--amber); letter-spacing: -0.02em;
  text-shadow: 0 0 30px oklch(0.80 0.14 62 / 0.18);
}
.lp-price-label {
  font-family: var(--mono); font-size: 10px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--bg); background: var(--amber);
  padding: 3px 10px; border-radius: 100px;
}
.lp-hero-actions { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }
.lp-btn-primary {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  font-family: var(--sans); font-size: 15px; font-weight: 800;
  letter-spacing: 0.01em;
  padding: 14px 32px; border-radius: 100px; cursor: pointer;
  background: var(--amber); color: oklch(0.09 0.008 240);
  border: none; transition: all 0.2s; text-decoration: none;
  box-shadow: 0 18px 46px oklch(0.80 0.14 62 / 0.22);
}
.lp-btn-primary:hover { background: oklch(0.86 0.14 62); transform: translateY(-1px); }
.lp-btn-full { width: 100%; }
.lp-btn-ghost {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--sans); font-size: 14px; font-weight: 500;
  padding: 14px 24px; border-radius: 100px;
  border: 1px solid var(--line); color: var(--text-2);
  background: none; cursor: pointer; transition: all 0.2s; text-decoration: none;
}
.lp-btn-ghost:hover { border-color: var(--text-3); color: var(--text); }
.lp-hero-specs { display: flex; gap: 20px; flex-wrap: wrap; }
.lp-fast-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: -18px 0 28px;
}
.lp-fast-trust span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 28px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid var(--line-s);
  background: oklch(0.07 0.006 240 / 0.68);
  font-family: var(--mono);
  font-size: 9.5px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--text-2);
}
.lp-fast-trust span::before {
  content: '';
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--amber);
  box-shadow: 0 0 10px var(--amber);
}
.lp-spec {
  font-family: var(--mono); font-size: 11px;
  color: var(--text-3); letter-spacing: 0.04em;
  display: flex; align-items: center; gap: 8px;
}
.lp-spec-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--amber-d); }

/* Book 3D with real cover */
.lp-book-3d {
  position: relative;
  width: 300px;
  perspective: 1200px;
}
.lp-book-3d .lp-book-glow {
  position: absolute; top: -20%; left: -20%; width: 140%; height: 140%;
  background: radial-gradient(ellipse at 40% 30%, oklch(0.80 0.14 62 / 0.12), transparent 60%);
  pointer-events: none; z-index: 0;
}
.lp-cover-img {
  position: relative; z-index: 1;
  width: 100%; height: auto;
  border-radius: 4px 14px 14px 4px;
  box-shadow:
    -8px 8px 0 oklch(0.10 0.01 240),
    0 32px 80px oklch(0 0 0 / 0.5),
    0 0 60px oklch(0.80 0.14 62 / 0.06);
  transition: transform 0.5s ease;
}
.lp-book-3d:hover .lp-cover-img {
  transform: rotateY(-4deg) scale(1.02);
}
.lp-cover-circuit {
  position: absolute; inset: 0; z-index: 2; pointer-events: none;
}
.lp-cover-circuit svg { width: 100%; height: 100%; }
.lp-hero-proof {
  margin-top: 14px;
  max-width: 360px;
  padding: 16px 18px;
  border: 1px solid var(--line-s);
  border-radius: 14px;
  background: oklch(0.08 0.008 240 / 0.8);
  box-shadow: 0 18px 50px oklch(0 0 0 / 0.22);
}
.lp-hero-proof strong,
.lp-hero-proof span {
  display: block;
}
.lp-hero-proof strong {
  font-size: 14px;
  line-height: 1.35;
}
.lp-hero-proof span {
  margin-top: 6px;
  font-size: 12px;
  color: var(--text-3);
  line-height: 1.55;
}
.lp-checkout-card {
  width: 100%;
  max-width: 360px;
  margin-top: 14px;
  padding: 16px;
  border: 1px solid oklch(0.80 0.14 62 / 0.28);
  border-radius: 18px;
  background:
    linear-gradient(160deg, oklch(0.80 0.14 62 / 0.10), transparent 48%),
    oklch(0.08 0.008 240 / 0.94);
  box-shadow: 0 24px 70px oklch(0 0 0 / 0.34);
}
.lp-checkout-kicker {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--amber);
  margin-bottom: 14px;
}
.lp-checkout-product {
  display: flex;
  gap: 12px;
  align-items: center;
  padding-bottom: 14px;
  margin-bottom: 12px;
  border-bottom: 1px solid var(--line-s);
}
.lp-checkout-product img {
  width: 48px;
  height: 68px;
  object-fit: cover;
  border-radius: 5px;
}
.lp-checkout-product strong,
.lp-checkout-product span {
  display: block;
}
.lp-checkout-product strong {
  font-size: 14px;
  line-height: 1.25;
}
.lp-checkout-product span {
  margin-top: 4px;
  font-size: 12px;
  color: var(--text-3);
}
.lp-checkout-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 8px 0;
  font-size: 13px;
  color: var(--text-2);
}
.lp-checkout-row strong {
  color: var(--text);
}
.lp-checkout-card .lp-btn-primary {
  margin-top: 12px;
  min-height: 46px;
  padding: 12px 18px;
}

/* Offer cover spread */
.lp-offer-cover-wrap {
  position: relative;
}
.lp-offer-spread {
  width: 100%; max-width: 560px; height: auto;
  border-radius: 12px;
  box-shadow: 0 24px 60px oklch(0 0 0 / 0.4), 0 0 40px oklch(0.80 0.14 62 / 0.05);
}
.lp-offer-cover-glow {
  position: absolute; inset: -20%; z-index: -1;
  background: radial-gradient(ellipse, oklch(0.80 0.14 62 / 0.06), transparent 70%);
  border-radius: 50%;
}

/* Section SVG backgrounds */
.lp-circuit-bg, .lp-neural-bg, .lp-flow-bg, .lp-hex-bg {
  position: absolute; inset: 0; pointer-events: none; z-index: 0;
}
.lp-circuit-bg svg, .lp-neural-bg svg, .lp-flow-bg svg, .lp-hex-bg svg {
  width: 100%; height: 100%;
}

@media(max-width:900px){
  .lp-book-3d { width: 240px; }
  .lp-offer-spread { max-width: 400px; }
}

/* Trust strip */
.lp-trust {
  border-top: 1px solid var(--line-s); border-bottom: 1px solid var(--line-s);
  background: var(--bg-2); padding: 20px 0;
}
.lp-trust-inner {
  display: flex; align-items: center; justify-content: center;
  gap: 36px; flex-wrap: wrap;
}
.lp-trust-item {
  display: flex; align-items: center; gap: 10px;
  font-family: var(--mono); font-size: 11px;
  color: var(--text-2); letter-spacing: 0.03em;
}
.lp-trust-ico { font-size: 16px; }
.lp-trust-ico {
  min-width: 34px;
  height: 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line-s);
  border-radius: 8px;
  background: oklch(0.07 0.006 240 / 0.72);
  color: var(--amber);
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.06em;
}

/* Sections */
.lp-section { padding: 100px 0; }
.lp-section-alt { background: var(--bg-2); }
@media(max-width:640px){ .lp-section { padding: 64px 0; } }

@media(max-width:900px){
  .lp-urgency-card { grid-template-columns: 1fr; }
  .lp-countdown { width: 100%; }
  .lp-countdown span { flex: 1; }
  .lp-outcomes-grid { grid-template-columns: 1fr 1fr; }
  .lp-proof-layout { grid-template-columns: 1fr; }
}

@media(max-width:640px){
  .lp-topbar .lp-wrap { height: 58px; }
  .lp-brand-sub { display: none; }
  .lp-brand-word { font-size: 18px; }
  .lp-brand-mark { width: 30px; height: 30px; border-radius: 9px; }
  .lp-topbar-cta { padding: 9px 11px; font-size: 9px; }
  .lp-h1 { font-size: clamp(36px, 10.6vw, 48px); line-height: 1; letter-spacing: -0.03em; }
  .lp-hero-sub { font-size: 16px; }
  .lp-hero-price { flex-wrap: wrap; }
  .lp-price-current { font-size: 38px; }
  .lp-countdown { gap: 6px; }
  .lp-countdown span { min-width: 0; padding: 10px 6px 8px; }
  .lp-countdown b { font-size: 18px; }
  .lp-countdown small { font-size: 7px; }
  .lp-outcomes-grid { grid-template-columns: 1fr; }
  .lp-outcome-card { min-height: auto; }
  .lp-interactive-bg { opacity: 0.52; }
  .lp-hero-actions { flex-direction: column; gap: 10px; }
  .lp-btn-primary, .lp-btn-ghost { width: 100%; }
  .lp-fast-trust { margin-top: -12px; }
  .lp-hero-specs { gap: 10px 14px; }
  .lp-hero-mockup { order: 0; }
  .lp-book-3d { width: min(190px, 58vw); }
  .lp-hero-proof { display: none; }
  .lp-checkout-card { max-width: 100%; }
  .lp-trust-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lp-trust-item { justify-content: flex-start; }
  body { padding-bottom: 86px; }
}

.lp-section-header {
  display: flex; align-items: center; gap: 20px;
  margin-bottom: 48px; padding-bottom: 20px;
  border-bottom: 1px solid var(--line-s);
}
.lp-section-num {
  font-family: var(--mono); font-size: 11px; font-weight: 500;
  color: var(--text-3); letter-spacing: 0.05em;
}
.lp-section-rule { flex: 1; height: 1px; background: var(--line-s); }
.lp-section-label {
  font-family: var(--mono); font-size: 11px; font-weight: 500;
  letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-2);
}

.lp-h2 {
  font-family: var(--serif);
  font-size: clamp(26px, 3.5vw, 44px);
  font-weight: 700; line-height: 1.15;
  letter-spacing: -0.02em; margin-bottom: 48px;
  max-width: 700px;
}
.lp-h2 em { font-style: italic; color: var(--amber); }

.lp-section-intro {
  font-size: 16px; color: var(--text-2); line-height: 1.7;
  max-width: 640px; margin-bottom: 48px;
}

/* Problem section */
.lp-problem-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 16px; margin-bottom: 40px;
}
.lp-problem-card {
  background: var(--bg-2); border: 1px solid var(--line-s);
  border-radius: 12px; padding: 28px;
  border-left: 3px solid oklch(0.65 0.15 25);
}
.lp-problem-label {
  font-family: var(--mono); font-size: 10.5px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: oklch(0.75 0.12 25); margin-bottom: 12px;
}
.lp-problem-desc { font-size: 14px; color: var(--text-2); line-height: 1.7; }
.lp-problem-pivot {
  max-width: 680px;
  font-size: 16px; color: var(--text-2); line-height: 1.7;
  padding: 24px 0; border-top: 1px solid var(--line-s);
}
.lp-problem-pivot p { margin: 0; }
.lp-inline-cta {
  display: inline-flex;
  margin-top: 18px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--amber);
}

/* Outcomes */
.lp-section-outcomes {
  background:
    linear-gradient(180deg, transparent, oklch(0.08 0.006 240 / 0.82)),
    var(--bg);
}
.lp-outcomes-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 42px;
}
.lp-outcome-card {
  position: relative;
  overflow: hidden;
  min-height: 230px;
  padding: 26px;
  border: 1px solid var(--line-s);
  border-radius: 14px;
  background:
    radial-gradient(circle at 80% 0%, oklch(0.72 0.18 338 / 0.12), transparent 55%),
    var(--bg-2);
}
.lp-outcome-card::after {
  content: '';
  position: absolute;
  inset: auto 20px 20px auto;
  width: 44px;
  height: 1px;
  background: var(--amber);
  opacity: 0.7;
}
.lp-outcome-num {
  display: inline-flex;
  margin-bottom: 34px;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--amber);
  letter-spacing: 0.08em;
}
.lp-outcome-card h3 {
  font-family: var(--serif);
  font-size: 21px;
  line-height: 1.15;
  letter-spacing: -0.01em;
  margin: 0 0 12px;
}
.lp-outcome-card p {
  margin: 0;
  font-size: 13.5px;
  line-height: 1.65;
  color: var(--text-2);
}

/* Value proof */
.lp-proof-section {
  background:
    radial-gradient(circle at 72% 40%, oklch(0.72 0.18 338 / 0.12), transparent 26rem),
    var(--bg);
}
.lp-proof-layout {
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(360px, 1.18fr);
  gap: 52px;
  align-items: center;
}
.lp-proof-points {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: -18px 0 28px;
}
.lp-proof-points span {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 7px 12px;
  border: 1px solid var(--line-s);
  border-radius: 999px;
  background: oklch(0.08 0.008 240 / 0.78);
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-2);
}
.lp-proof-board {
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 16px;
  align-items: stretch;
  border: 1px solid oklch(0.72 0.18 338 / 0.28);
  border-radius: 20px;
  padding: 18px;
  background:
    linear-gradient(135deg, oklch(0.72 0.18 338 / 0.15), transparent 46%),
    oklch(0.06 0.006 240 / 0.9);
  box-shadow: 0 32px 90px oklch(0 0 0 / 0.42), 0 0 80px oklch(0.72 0.18 338 / 0.1);
}
.lp-proof-board::before {
  content: '';
  position: absolute;
  inset: 1px;
  border-radius: inherit;
  background-image:
    linear-gradient(oklch(1 0 0 / 0.04) 1px, transparent 1px),
    linear-gradient(90deg, oklch(1 0 0 / 0.04) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: radial-gradient(circle at 50% 50%, black, transparent 72%);
  pointer-events: none;
}
.lp-proof-card,
.lp-proof-price {
  position: relative;
  z-index: 1;
  border: 1px solid var(--line-s);
  border-radius: 16px;
  background: oklch(0.08 0.008 240 / 0.84);
  padding: 24px;
}
.lp-proof-card-hot {
  border-color: oklch(0.65 0.15 25 / 0.4);
  background: linear-gradient(180deg, oklch(0.65 0.15 25 / 0.12), oklch(0.08 0.008 240 / 0.84));
}
.lp-proof-card span,
.lp-proof-price small {
