---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EBOOK_OFFER } from '../../data/ebookOffer.js';
---

<BaseLayout
  title="Checkout Seguro - Framework Operacional de Agentes de IA"
  description="Finalize sua compra do Framework Operacional de Agentes de IA para Negócios."
  active="Ebooks"
>
  <main class="stripe-checkout-page">
    <section class="checkout-shell">
      <div class="checkout-left">
        <a class="manual-back" href="/ebook-agentes-ia/">← Voltar para a página do framework</a>
        <div class="checkout-kicker">Checkout seguro Tech Briefing</div>
        <h1>Finalize seu acesso ao framework que transforma IA em processo real.</h1>
        <p class="checkout-lead">{EBOOK_OFFER.subtitle}</p>

        <div class="checkout-proof-row">
          <div><strong>7 dias</strong><span>garantia</span></div>
          <div><strong>{EBOOK_OFFER.pages}</strong><span>páginas</span></div>
          <div><strong>PDF + EPUB</strong><span>acesso imediato</span></div>
        </div>

        <div class="checkout-section">
          <h2>O que você recebe</h2>
          <div class="checkout-benefits">
            {EBOOK_OFFER.benefits.map((benefit) => <div><span>✓</span>{benefit}</div>)}
          </div>
        </div>

        <div class="checkout-section">
          <h2>Bônus inclusos</h2>
          <div class="checkout-bonus-grid">
            {EBOOK_OFFER.bonuses.map((bonus) => <div>{bonus}</div>)}
          </div>
        </div>
      </div>

      <aside class="checkout-card" aria-label="Resumo da compra">
        <div class="checkout-product">
          <div class="checkout-cover" aria-hidden="true">
            <span>IA</span>
            <strong>Agentes de IA para Negócios</strong>
          </div>
          <div>
            <span>Framework completo</span>
            <strong>{EBOOK_OFFER.name}</strong>
          </div>
        </div>

        <div class="checkout-price">
          {EBOOK_OFFER.oldPrice && <span>De R$ {EBOOK_OFFER.oldPrice.toFixed(2).replace('.', ',')}</span>}
          <strong>R$ {EBOOK_OFFER.price.toFixed(2).replace('.', ',')}</strong>
          <em>Pagamento único</em>
        </div>

        <button class="checkout-pay-button" type="button" data-stripe-checkout>
          Pagar com segurança →
        </button>
        <p class="checkout-error" data-checkout-error hidden></p>
        <a class="checkout-fallback" href={EBOOK_OFFER.fallbackKiwifyUrl} rel="nofollow">Usar checkout Kiwify</a>

        <div class="checkout-security">
          <div><strong>Pagamento seguro</strong><span>checkout criptografado</span></div>
          <div><strong>Tech Briefing</strong><span>produto digital brasileiro</span></div>
          <div><strong>Garantia</strong><span>7 dias para testar sem risco</span></div>
        </div>
      </aside>
    </section>
  </main>

  <script is:inline>
    (() => {
      const button = document.querySelector('[data-stripe-checkout]');
      const errorBox = document.querySelector('[data-checkout-error]');
      if (!button) return;

      const showError = (message) => {
        if (!errorBox) return;
        errorBox.textContent = message;
        errorBox.hidden = false;
      };

      button.addEventListener('click', async () => {
        button.disabled = true;
        button.textContent = 'Abrindo pagamento seguro...';
        if (errorBox) {
          errorBox.hidden = true;
          errorBox.textContent = '';
        }

        window.trackEbookCheckout?.({
          checkout_provider: 'stripe',
          checkout_step: 'site_checkout',
          source_path: window.location.pathname,
        });

        try {
          const response = await fetch('/api/stripe/create-checkout-session', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              sourcePath: window.location.pathname,
              clientReferenceId: window.crypto?.randomUUID?.() || String(Date.now()),
            }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.url) throw new Error(data.error || 'Não foi possível abrir o checkout.');
          window.location.href = data.url;
        } catch (error) {
          button.disabled = false;
          button.textContent = 'Tentar novamente';
          showError(error.message || 'Erro ao abrir o pagamento. Tente novamente ou use o checkout Kiwify.');
        }
      });
    })();
  </script>
</BaseLayout>
