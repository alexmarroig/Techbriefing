---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fórum da Comunidade | Tech Briefing" description="Participe do Fórum do Tech Briefing. Tire dúvidas sobre IA, compartilhe automações e converse com outros profissionais." type="website">
  <main class="forum-page">
    <header class="forum-hero">
      <div class="container">
        <div class="hero-badge">Comunidade Tech Briefing</div>
        <h1>Construa o futuro <span class="text-gradient">junto com a gente</span></h1>
        <p class="hero-subtitle">
          Não enfrente o código legado sozinho. Conecte-se com centenas de profissionais, compartilhe seus workflows de IA e evolua na velocidade da tecnologia.
        </p>
      </div>
    </header>

    <section class="forum-benefits">
      <div class="container">
        <div class="benefits-grid">
          <div class="benefit-card">
            <div class="icon-wrapper">🤖</div>
            <h3>Agentes & Automação</h3>
            <p>Compartilhe blueprints do n8n, fluxos do Make e prompts avançados que economizam horas de trabalho.</p>
          </div>
          <div class="benefit-card">
            <div class="icon-wrapper">🐛</div>
            <h3>Debugging Coletivo</h3>
            <p>Travou naquele erro misterioso? Nossa comunidade adora resolver problemas impossíveis. Juntos somos mais fortes.</p>
          </div>
          <div class="benefit-card">
            <div class="icon-wrapper">🤝</div>
            <h3>Networking Real</h3>
            <p>Faça parcerias em projetos open-source, encontre vagas ocultas e conecte-se com líderes da área de tecnologia.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="forum-cta-section">
      <div class="container">
        <div class="forum-cta-box">
          <div class="cta-content">
            <h2>Tópicos e Discussões Completas</h2>
            <p>
              Nosso fórum principal é hospedado no <strong>GitHub Discussions</strong>. Escolhemos essa plataforma para garantir velocidade, markdown nativo para código e <em>zero propagandas</em>.
            </p>
            <a href="https://github.com/alexmarroig/Techbriefing/discussions" target="_blank" rel="noopener noreferrer" class="btn btn-fill btn-glow">
              Acessar o Fórum no GitHub <span class="arrow">&#8594;</span>
            </a>
          </div>
          <div class="cta-visual">
            <div class="code-window">
              <div class="window-header">
                <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
              </div>
              <pre><code><span class="keyword">import</span> { Community } <span class="keyword">from</span> <span class="string">'@tech-briefing/forum'</span>;

<span class="keyword">const</span> dev = <span class="keyword">new</span> Community.Member();

dev.askQuestion(<span class="string">"Como escalar agentes IA?"</span>)
   .then(answers => console.log(<span class="string">"Resolvido!"</span>));</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="forum-general-chat">
      <div class="container" style="max-width: 800px; margin: 0 auto;">
        <div class="chat-header">
          <h2>Mural de Recados Rápido</h2>
          <p>
            Quer apenas deixar um "olá" ou dar um feedback rápido sem sair do site? Use o chat geral abaixo (conectado via sua conta do GitHub).
          </p>
        </div>

        <div class="giscus-glass-container">
          <script is:inline>
            (function() {
              const getTheme = () => document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
              
              const script = document.createElement('script');
              script.src = "https://giscus.app/client.js";
              script.setAttribute("data-repo", "alexmarroig/Techbriefing");
              script.setAttribute("data-repo-id", "R_kgDOSWXDkA");
              script.setAttribute("data-mapping", "pathname");
              script.setAttribute("data-strict", "0");
              script.setAttribute("data-reactions-enabled", "1");
              script.setAttribute("data-emit-metadata", "0");
              script.setAttribute("data-input-position", "top");
              script.setAttribute("data-theme", getTheme());
              script.setAttribute("data-lang", "pt");
              script.setAttribute("crossorigin", "anonymous");
              script.async = true;
              
              document.currentScript.parentNode.appendChild(script);

              const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                  if (mutation.attributeName === 'data-theme') {
                    const iframe = document.querySelector('iframe.giscus-frame');
                    if (iframe) {
                      iframe.contentWindow.postMessage(
                        { giscus: { setConfig: { theme: getTheme() } } },
                        'https://giscus.app'
                      );
                    }
                  }
                });
              });
              observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
            })();
          </script>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .forum-page {
    padding-bottom: 80px;
  }
  .forum-hero {
    padding: 100px 0 60px;
    text-align: center;
    background: radial-gradient(circle at top, var(--bg-2) 0%, transparent 70%);
  }
  .hero-badge {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 100px;
    background: var(--bg-3);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .forum-hero h1 {
    margin-bottom: 20px;
    font-size: clamp(40px, 6vw, 56px);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .text-gradient {
    background: linear-gradient(135deg, var(--text) 0%, #6b7280 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtitle {
    max-width: 650px;
    margin: 0 auto;
    font-size: 20px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Benefits */
  .forum-benefits {
    padding: 40px 0;
  }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .benefit-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    padding: 32px;
    border-radius: 20px;
    transition: transform 0.3s ease, background 0.3s ease;
    backdrop-filter: blur(10px);
  }
  .benefit-card:hover {
    transform: translateY(-5px);
    background: var(--bg-2);
  }
  .icon-wrapper {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-3);
    border-radius: 12px;
    font-size: 24px;
    margin-bottom: 20px;
  }
  .benefit-card h3 {
    font-size: 20px;
    margin-bottom: 12px;
  }
  .benefit-card p {
    color: var(--text-muted);
    line-height: 1.5;
    font-size: 15px;
  }

  /* CTA Section */
  .forum-cta-section {
    padding: 60px 0;
  }
  .forum-cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 48px;
    border-radius: 32px;
    background: linear-gradient(145deg, var(--bg-2) 0%, var(--bg) 100%);
    border: 1px solid var(--border);
    box-shadow: 0 24px 48px rgba(0,0,0,0.05);
    overflow: hidden;
  }
  .cta-content {
    flex: 1;
    max-width: 500px;
  }
  .cta-content h2 {
    font-size: 32px;
    margin-bottom: 16px;
    line-height: 1.2;
  }
  .cta-content p {
    color: var(--text-muted);
    margin-bottom: 32px;
    font-size: 16px;
    line-height: 1.6;
  }
  .btn-glow {
    position: relative;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
  }
  .btn-glow .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
    margin-left: 8px;
  }
  .btn-glow:hover .arrow {
    transform: translateX(4px);
  }

  .cta-visual {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }
  .code-window {
    background: #0d1117;
    border-radius: 12px;
    border: 1px solid #30363d;
    width: 100%;
    max-width: 450px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }
  .window-header {
    background: #161b22;
    padding: 12px 16px;
    display: flex;
    gap: 8px;
    border-bottom: 1px solid #30363d;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }
  .code-window pre {
    margin: 0;
    padding: 24px;
    font-family: var(--mono);
    font-size: 13px;
    color: #c9d1d9;
    overflow-x: auto;
    line-height: 1.5;
  }
  .keyword { color: #ff7b72; }
  .string { color: #a5d6ff; }

  /* General Chat */
  .forum-general-chat {
    padding: 40px 0 80px;
  }
  .chat-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .chat-header h2 {
    font-size: 32px;
    margin-bottom: 16px;
  }
  .chat-header p {
    color: var(--text-muted);
    font-size: 16px;
    max-width: 600px;
    margin: 0 auto;
  }
  .giscus-glass-container {
    background: var(--bg-2);
    border: 1px solid var(--border);
    padding: 32px;
    border-radius: 24px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.02);
  }

  @media (max-width: 900px) {
    .forum-cta-box {
      flex-direction: column;
      padding: 32px;
    }
    .cta-visual {
      width: 100%;
      justify-content: center;
      margin-top: 24px;
    }
    .code-window {
      max-width: 100%;
    }
  }
</style>
