---
import BaseLayout from '../layouts/BaseLayout.astro';

const memes = [
  {
    src: '/images/memes/meme1.png',
    pt: 'Quando a gambiarra funciona em produção',
    en: 'When the workaround works in production'
  },
  {
    src: '/images/memes/meme2.png',
    pt: 'Na minha máquina funciona perfeitamente',
    en: 'It works perfectly on my machine'
  },
  {
    src: '/images/memes/meme3.png',
    pt: 'Existem 10 tipos de pessoas: as que entendem binário e as que não',
    en: 'There are 10 types of people: those who understand binary and those who don\'t'
  },
  {
    src: '/images/memes/meme4.png',
    pt: 'Deploy na sexta-feira às 17h',
    en: 'Deploy on Friday at 5 PM'
  },
  {
    src: '/images/memes/meme5.png',
    pt: 'Para entender recursão, você precisa entender recursão',
    en: 'To understand recursion, you must understand recursion'
  },
  {
    src: '/images/memes/meme6.png',
    pt: 'Eu vou lembrar o que esse código faz amanhã',
    en: 'I will remember what this code does tomorrow'
  },
  {
    src: '/images/memes/meme7.png',
    pt: '99 pequenos bugs no código. Corrija um, compile, 127 pequenos bugs no código.',
    en: '99 little bugs in the code. Patch one down, 127 little bugs in the code.'
  },
  {
    src: '/images/memes/meme8.png',
    pt: 'Light theme? Você quis dizer: farol de milha',
    en: 'Light theme? You mean: flashbang'
  },
  {
    src: '/images/memes/meme9.png',
    pt: 'Se está funcionando, não toque. Nunca.',
    en: 'If it ain\'t broke, don\'t fix it. Ever.'
  }
];

const seoDescription = "A maior galeria de memes de TI, programação, inteligência artificial e mundo corporativo tech. Porque rir do código legado é melhor do que chorar.";
---

<BaseLayout 
  title="/dev/null | Memes & Humor Tech" 
  description={seoDescription} 
  type="website"
  image="/images/memes/meme1.png"
  tags={["memes TI", "memes programação", "humor dev", "memes inteligência artificial", "piadas programação"]}
>
  <main class="memes-page">
    <header class="memes-hero">
      <div class="wrap">
        <h1>/dev/null 🗑️</h1>
        <p class="hero-subtitle">
          Um repositório cômico de dores diárias. Afinal, se a gente não rir do <code>console.log("socorro")</code>, a gente chora.
        </p>
        
        <div class="lang-toggle-wrap">
          <div class="lang-toggle" id="lang-toggle">
            <button class="active" data-lang="pt">🇧🇷 Títulos em PT</button>
            <button data-lang="en">🇺🇸 Títulos em EN</button>
          </div>
        </div>
      </div>
    </header>

    <section class="memes-grid-section">
      <div class="wrap">
        <div class="masonry-grid" id="memes-container" data-current-lang="pt">
          {memes.map(meme => (
            <div class="meme-card">
              <img src={meme.src} alt={meme.en} loading="lazy" />
              <div class="meme-overlay">
                <span class="meme-title-text" data-pt={meme.pt} data-en={meme.en}>{meme.pt}</span>
              </div>
            </div>
          ))}
        </div>
        
        <div class="submit-meme-box">
          <p>Uncaught Exception: Meme muito bom, quer commitar ele aqui?</p>
          <a href="/forum" class="btn btn-fill"><code>git push --forum</code></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('lang-toggle');
    if(!toggle) return;
    
    const buttons = toggle.querySelectorAll('button');
    const container = document.getElementById('memes-container');
    const texts = document.querySelectorAll('.meme-title-text');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        
        // Update buttons
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Update container lang
        container.setAttribute('data-current-lang', lang);
        
        // Update texts
        texts.forEach(textEl => {
          const newText = textEl.getAttribute(`data-${lang}`);
          if (newText) {
            textEl.innerHTML = newText;
          }
        });
      });
    });
  });
</script>

<style>
  .memes-page {
    padding-bottom: 80px;
  }
  .memes-hero {
    padding: 80px 0 40px;
    text-align: center;
    background: linear-gradient(180deg, var(--bg-2) 0%, transparent 100%);
  }
  .memes-hero h1 {
    margin-bottom: 16px;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.02em;
    font-family: var(--mono);
  }
  .hero-subtitle {
    max-width: 600px;
    margin: 0 auto;
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }
  .hero-subtitle code {
    background: var(--bg-3);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }
  
  .lang-toggle-wrap {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }
  .lang-toggle {
    display: inline-flex;
    background: var(--bg-3);
    border-radius: 100px;
    padding: 4px;
    border: 1px solid var(--border);
  }
  .lang-toggle button {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--sans);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lang-toggle button:hover {
    color: var(--text);
  }
  .lang-toggle button.active {
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    border: 1px solid var(--border);
  }
  
  .memes-grid-section {
    padding: 40px 0;
  }

  .memes-grid-section .wrap {
    max-width: 1150px;
  }

  /* Masonry Layout */
  .masonry-grid {
    column-count: 3;
    column-gap: 24px;
    padding-bottom: 60px;
  }
  
  @media (max-width: 900px) {
    .masonry-grid {
      column-count: 2;
    }
  }
  
  @media (max-width: 600px) {
    .masonry-grid {
      column-count: 1;
    }
  }

  .meme-card {
    break-inside: avoid;
    margin-bottom: 24px;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-2);
    border: 1px solid var(--border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .meme-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }

  .meme-card img {
    width: 100%;
    display: block;
    height: auto;
  }

  .meme-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 24px 20px 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    color: #fff;
    opacity: 1; /* Always visible so the language toggle has immediate feedback */
  }

  .meme-title-text {
    font-weight: 600;
    font-size: 15px;
    font-family: var(--sans);
    line-height: 1.4;
    display: block;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .submit-meme-box {
    margin: 0 auto;
    max-width: 500px;
    padding: 32px;
    text-align: center;
    border-radius: 16px;
    background: var(--bg-2);
    border: 1px dashed var(--border-hover);
  }

  .submit-meme-box p {
    margin-bottom: 16px;
    font-weight: 500;
    color: var(--text-muted);
  }
  .submit-meme-box a code {
    font-size: 1.1em;
    font-weight: 600;
  }
</style>lor: var(--text-muted);
