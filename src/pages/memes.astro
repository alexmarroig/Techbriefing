---
import BaseLayout from '../layouts/BaseLayout.astro';

const memes = [
  {
    src: '/images/memes/meme_1_notext.png',
    pt: 'ENGENHARIA DE PROMPT\\nEM 2026',
    en: 'PROMPT ENGINEERING\\nIN 2026',
    pos: 'top'
  },
  {
    src: '/images/memes/meme_2_notext.png',
    pt: 'QUANDO A IA DESCOBRE QUE VAI\\nMANTER CÓDIGO LEGADO',
    en: 'WHEN THE AI REALIZES IT HAS\\nTO MAINTAIN LEGACY CODE',
    pos: 'top'
  },
  {
    src: '/images/memes/meme_3_notext.png',
    pt: 'IA: "1+1 = 3. E AQUI ESTÁ UM\\nENSAIO DE 5 PARÁGRAFOS..."',
    en: 'AI: "1+1 = 3. AND HERE IS A\\n5 PARAGRAPH ESSAY..."',
    pos: 'bottom'
  }
];

const seoDescription = "A maior galeria de memes de TI, programação, inteligência artificial e mundo corporativo tech. Porque rir do código legado é melhor do que chorar.";
---

<BaseLayout 
  title="Humor Tech & Memes de IA | Tech Briefing" 
  description={seoDescription} 
  type="website"
  image="/images/memes/meme_1_notext.png"
  tags={["memes TI", "memes programação", "humor dev", "memes inteligência artificial", "piadas programação"]}
>
  <main class="memes-page">
    <header class="memes-hero">
      <div class="container">
        <h1>Humor Tech & IA 🤖</h1>
        <p class="hero-subtitle">
          Um respiro cômico para a comunidade. Porque se a gente não rir do código legado, a gente chora.
        </p>
        
        <div class="lang-toggle-wrap">
          <div class="lang-toggle" id="lang-toggle">
            <button class="active" data-lang="pt">🇧🇷 Português</button>
            <button data-lang="en">🇺🇸 English</button>
          </div>
        </div>
      </div>
    </header>

    <section class="memes-grid-section">
      <div class="container">
        <div class="masonry-grid" id="memes-container" data-current-lang="pt">
          {memes.map(meme => (
            <div class="meme-card">
              <div class="meme-generator-box">
                <img src={meme.src} alt={meme.en} loading="lazy" />
                <div class={`meme-text meme-text-${meme.pos}`} data-pt={meme.pt} data-en={meme.en}>
                  {meme.pt.split('\\n').map((line, i) => (
                    <>
                      {line}
                      {i < meme.pt.split('\\n').length - 1 && <br />}
                    </>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <div class="submit-meme-box">
          <p>Fez um meme bom e quer colocar aqui?</p>
          <a href="/forum" class="btn btn-fill">Mande no Fórum</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('lang-toggle');
    if(!toggle) return;
    
    const buttons = toggle.querySelectorAll('button');
    const container = document.getElementById('memes-container');
    const texts = document.querySelectorAll('.meme-text');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        
        // Update buttons
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Update container lang
        container.setAttribute('data-current-lang', lang);
        
        // Update texts
        texts.forEach(textEl => {
          const newText = textEl.getAttribute(`data-${lang}`);
          if (newText) {
            textEl.innerHTML = newText.replace(/\\n/g, '<br>');
          }
        });
      });
    });
  });
</script>

<style>
  .memes-page {
    padding-bottom: 80px;
  }
  .memes-hero {
    padding: 80px 0 40px;
    text-align: center;
    background: linear-gradient(180deg, var(--bg-2) 0%, transparent 100%);
  }
  .memes-hero h1 {
    margin-bottom: 16px;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.02em;
  }
  .hero-subtitle {
    max-width: 600px;
    margin: 0 auto;
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }
  
  .lang-toggle-wrap {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }
  .lang-toggle {
    display: inline-flex;
    background: var(--bg-3);
    border-radius: 100px;
    padding: 4px;
    border: 1px solid var(--border);
  }
  .lang-toggle button {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--sans);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lang-toggle button:hover {
    color: var(--text);
  }
  .lang-toggle button.active {
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    border: 1px solid var(--border);
  }
  
  .memes-grid-section {
    padding: 40px 0;
  }

  .memes-grid-section .container {
    max-width: 1000px;
  }

  /* Masonry Layout */
  .masonry-grid {
    column-count: 3;
    column-gap: 24px;
    padding-bottom: 60px;
  }
  
  @media (max-width: 900px) {
    .masonry-grid {
      column-count: 2;
    }
  }
  
  @media (max-width: 600px) {
    .masonry-grid {
      column-count: 1;
    }
  }

  .meme-card {
    break-inside: avoid;
    margin-bottom: 24px;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-2);
    border: 1px solid var(--border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .meme-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }

  .meme-generator-box {
    position: relative;
    width: 100%;
  }

  .meme-generator-box img {
    width: 100%;
    display: block;
    height: auto;
  }

  /* Meme text CSS */
  .meme-text {
    position: absolute;
    left: 0;
    width: 100%;
    text-align: center;
    color: white;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0 16px;
    text-shadow: 
      -2px -2px 0 #000,
       2px -2px 0 #000,
      -2px  2px 0 #000,
       2px  2px 0 #000,
       0px  3px 0 #000,
       3px  0px 0 #000;
  }
  
  .meme-text-top {
    top: 4%;
  }
  
  .meme-text-bottom {
    bottom: 4%;
  }

  .submit-meme-box {
    margin: 0 auto;
    max-width: 500px;
    padding: 32px;
    text-align: center;
    border-radius: 16px;
    background: var(--bg-2);
    border: 1px dashed var(--border-hover);
  }

  .submit-meme-box p {
    margin-bottom: 16px;
    font-weight: 500;
    color: var(--text-muted);
  }
</style>
