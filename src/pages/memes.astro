---
import BaseLayout from '../layouts/BaseLayout.astro';

const memes = [
  {
    src: '/images/memes/meme1.png',
    pt: 'Quando a gambiarra funciona em produção',
    en: 'When the workaround works in production'
  },
  {
    src: '/images/memes/meme2.png',
    pt: 'Na minha máquina funciona perfeitamente',
    en: 'It works perfectly on my machine'
  },
  {
    src: '/images/memes/meme3.png',
    pt: 'Existem 10 tipos de pessoas: as que entendem binário e as que não',
    en: 'There are 10 types of people: those who understand binary and those who don\'t'
  },
  {
    src: '/images/memes/meme4.png',
    pt: 'Deploy na sexta-feira às 17h',
    en: 'Deploy on Friday at 5 PM'
  },
  {
    src: '/images/memes/meme5.png',
    pt: 'Para entender recursão, você precisa entender recursão',
    en: 'To understand recursion, you must understand recursion'
  },
  {
    src: '/images/memes/meme6.png',
    pt: 'Eu vou lembrar o que esse código faz amanhã',
    en: 'I will remember what this code does tomorrow'
  },
  {
    src: '/images/memes/meme7.png',
    pt: '99 pequenos bugs no código. Corrija um, compile, 127 pequenos bugs no código.',
    en: '99 little bugs in the code. Patch one down, 127 little bugs in the code.'
  },
  {
    src: '/images/memes/meme8.png',
    pt: 'Light theme? Você quis dizer: farol de milha',
