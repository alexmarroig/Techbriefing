    pt: 'Quando a gambiarra\nfunciona em produção',
    en: 'When the workaround\nworks in production'
  },
  {
    src: '/images/memes/meme2_notext.png',
    pt: 'Na minha máquina\nfunciona perfeitamente',
    en: 'It works perfectly\non my machine'
  },
  {
    src: '/images/memes/meme3_notext.png',
    pt: 'Existem 10 tipos de pessoas:\nas que entendem binário e as que não',
    en: 'There are 10 types of people:\nthose who understand binary and those who don\'t'
  },
  {
    src: '/images/memes/meme4_notext.png',
    pt: 'Deploy na sexta-feira\nàs 17h',
    en: 'Deploy on Friday\nat 5 PM'
  },
  {
    src: '/images/memes/meme5_notext.png',
    pt: 'Para entender recursão,\nvocê precisa entender recursão',
    en: 'To understand recursion,\nyou must understand recursion'
  },
  {
    src: '/images/memes/meme6_notext.png',
    pt: 'Eu vou lembrar\no que esse código faz amanhã',
    en: 'I will remember\nwhat this code does tomorrow'
  },
  {
    src: '/images/memes/meme7_notext.png',
