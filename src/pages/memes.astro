const seoDescription = "A maior galeria de memes de TI, programação, inteligência artificial e mundo corporativo tech. Porque rir do código legado é melhor do que chorar.";
---

<BaseLayout 
  title="/dev/null | Memes & Humor Tech" 
  description={seoDescription} 
  type="website"
  image="/images/memes/meme1.png"
  tags={["memes TI", "memes programação", "humor dev", "memes inteligência artificial", "piadas programação"]}
>
  <main class="memes-page">
    <header class="memes-hero">
      <div class="wrap">
        <h1>/dev/null 🗑️</h1>
        <p class="hero-subtitle">
          Um repositório cômico de dores diárias. Afinal, se a gente não rir do <code>console.log("socorro")</code>, a gente chora.
        </p>
        
        <div class="lang-toggle-wrap">
          <div class="lang-toggle" id="lang-toggle">
            <button class="active" data-lang="pt">🇧🇷 Títulos em PT</button>
            <button data-lang="en">🇺🇸 Títulos em EN</button>
          </div>
        </div>
      </div>
    </header>

    <section class="memes-grid-section">
      <div class="wrap">
        <div class="masonry-grid" id="memes-container" data-current-lang="pt">
          {memes.map(meme => (
            <div class="meme-card">
              <img src={meme.src} alt={meme.en} loading="lazy" />
              <div class="meme-overlay">
                <span class="meme-title-text" data-pt={meme.pt} data-en={meme.en}>{meme.pt}</span>
              </div>
            </div>
          ))}
        </div>
        
        <div class="submit-meme-box">
          <p>Uncaught Exception: Meme muito bom, quer commitar ele aqui?</p>
          <a href="/forum" class="btn btn-fill"><code>git push --forum</code></a>
        </div>
      </div>
    </section>

    <!-- Lightbox Modal -->
    <div id="meme-lightbox" class="lightbox">
      <span class="lightbox-close" id="lightbox-close">&times;</span>
      <img class="lightbox-content" id="lightbox-img" />
      <div id="lightbox-caption"></div>
    </div>

  </main>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Language Toggle Logic ---
    const toggle = document.getElementById('lang-toggle');
    const container = document.getElementById('memes-container');
    const texts = document.querySelectorAll('.meme-title-text');
    let currentLang = 'pt';
    
    if(toggle && container) {
      const buttons = toggle.querySelectorAll('button');
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          currentLang = btn.getAttribute('data-lang');
          
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          container.setAttribute('data-current-lang', currentLang);
          
          texts.forEach(textEl => {
            const newText = textEl.getAttribute(`data-${currentLang}`);
            if (newText) {
              textEl.innerHTML = newText;
            }
          });
          
          // Se o lightbox estiver aberto, atualiza o caption também!
          const lightboxCaption = document.getElementById('lightbox-caption');
          const lightbox = document.getElementById('meme-lightbox');
          if (lightbox && lightbox.classList.contains('active') && activeMemeEl) {
            const newCaption = activeMemeEl.querySelector('.meme-title-text').getAttribute(`data-${currentLang}`);
            lightboxCaption.innerHTML = newCaption;
          }
        });
      });
    }

    // --- Lightbox Logic ---
    const lightbox = document.getElementById('meme-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');
    const memeCards = document.querySelectorAll('.meme-card');
    let activeMemeEl = null;

    if (lightbox && lightboxImg) {
      // Abre o lightbox ao clicar em um meme
      memeCards.forEach(card => {
        card.addEventListener('click', () => {
          activeMemeEl = card;
          const img = card.querySelector('img');
          const title = card.querySelector('.meme-title-text').getAttribute(`data-${currentLang}`);
          
          lightboxImg.src = img.src;
          lightboxCaption.innerHTML = title;
          
          // Animação de entrada
          lightbox.style.display = 'flex';
          // Force reflow
          void lightbox.offsetWidth;
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden'; // impede scroll da página
        });
      });

      // Fecha o lightbox
      const closeLightbox = () => {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
        setTimeout(() => {
          lightbox.style.display = 'none';
        }, 300); // tempo da animação CSS
      };

      lightboxClose.addEventListener('click', closeLightbox);
      
      // Fecha ao clicar fora da imagem
      lightbox.addEventListener('click', (e) => {
        if (e.target !== lightboxImg) {
          closeLightbox();
        }
      });
      
      // Fecha com a tecla ESC
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox.classList.contains('active')) {
          closeLightbox();
        }
      });
    }
  });
</script>

<style>
  .memes-page {
    padding-bottom: 80px;
  }
  .memes-hero {
    padding: 80px 0 40px;
    text-align: center;
    background: linear-gradient(180deg, var(--bg-2) 0%, transparent 100%);
  }
  .memes-hero h1 {
    margin-bottom: 16px;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.02em;
    font-family: var(--mono);
  }
  .hero-subtitle {
    max-width: 600px;
    margin: 0 auto;
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }
  .hero-subtitle code {
    background: var(--bg-3);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }
  
  .lang-toggle-wrap {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }
  .lang-toggle {
    display: inline-flex;
    background: var(--bg-3);
    border-radius: 100px;
    padding: 4px;
    border: 1px solid var(--border);
  }
  .lang-toggle button {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--sans);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lang-toggle button:hover {
    color: var(--text);
  }
  .lang-toggle button.active {
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    border: 1px solid var(--border);
  }
  
  .memes-grid-section {
    padding: 40px 0;
  }

  .memes-grid-section .wrap {
    max-width: 1150px;
  }

  /* Masonry Layout */
  .masonry-grid {
    column-count: 3;
    column-gap: 24px;
    padding-bottom: 60px;
  }
  
  @media (max-width: 900px) {
    .masonry-grid {
      column-count: 2;
    }
  }
  
  @media (max-width: 600px) {
    .masonry-grid {
      column-count: 1;
    }
  }

  .meme-card {
    break-inside: avoid;
    margin-bottom: 24px;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-2);
    border: 1px solid var(--border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: zoom-in; /* Indicate it's clickable */
  }

  .meme-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }

  .meme-card img {
    width: 100%;
    display: block;
    height: auto;
  }

  .meme-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 24px 20px 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    color: #fff;
    opacity: 1; 
  }

  .meme-title-text {
    font-weight: 600;
    font-size: 15px;
    font-family: var(--sans);
    line-height: 1.4;
    display: block;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  /* Lightbox Styles */
  .lightbox {
    display: none;
    position: fixed;
    z-index: 9999;
    padding-top: 60px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px); /* Efeito Blur lindo */
    opacity: 0;
    transition: opacity 0.3s ease;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .lightbox.active {
    opacity: 1;
  }

  .lightbox-content {
    margin: auto;
    display: block;
    max-width: 90%;
    max-height: 80vh;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    transform: scale(0.95) translateY(20px);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox.active .lightbox-content {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  #lightbox-caption {
    margin: 24px auto 0;
    display: block;
    width: 80%;
    max-width: 700px;
    text-align: center;
    color: #fff;
    font-size: 20px;
    font-family: var(--sans);
    font-weight: 500;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }
  
  .lightbox.active #lightbox-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    transition: 0.2s;
    cursor: pointer;
    z-index: 10000;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
  }

  .lightbox-close:hover,
  .lightbox-close:focus {
    color: #fff;
    background: rgba(255,255,255,0.2);
    text-decoration: none;
    cursor: pointer;
  }

  .submit-meme-box {
    margin: 0 auto;
    max-width: 500px;
    padding: 32px;
    text-align: center;
    border-radius: 16px;
    background: var(--bg-2);
    border: 1px dashed var(--border-hover);
  }

  .submit-meme-box p {
    margin-bottom: 16px;
    font-weight: 500;
    color: var(--text-muted);
  }
  .submit-meme-box a code {
    font-size: 1.1em;
    font-weight: 600;
  }
</style>lor: var(--text-muted);
