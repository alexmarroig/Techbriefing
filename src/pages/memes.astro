---
import BaseLayout from '../layouts/BaseLayout.astro';

const memes = [
  {
    src: '/images/memes/meme1.png',
    pt: 'Engenharia de Prompt',
    en: 'Prompt Engineering'
  },
  {
    src: '/images/memes/meme2.png',
    pt: 'Na minha máquina funciona',
    en: 'It works on my machine'
  },
  {
    src: '/images/memes/meme3.png',
    pt: 'IA e o código legado',
    en: 'AI maintaining legacy code'
  },
  {
    src: '/images/memes/meme4.png',
    pt: 'Sênior em dia de deploy',
    en: 'Senior dev on deploy day'
  },
  {
    src: '/images/memes/meme5.png',
    pt: 'Alucinação da IA',
    en: 'AI Hallucination'
  },
  {
    src: '/images/memes/meme6.png',
    pt: 'Git Push --force na Sexta',
    en: 'Git Push --force on Friday'
  }
];

const seoDescription = "A maior galeria de memes de TI, programação, inteligência artificial e mundo corporativo tech. Porque rir do código legado é melhor do que chorar.";
---

<BaseLayout 
  title="Humor Tech & Memes de IA | Tech Briefing" 
  description={seoDescription} 
  type="website"
  image="/images/memes/meme1.png"
  tags={["memes TI", "memes programação", "humor dev", "memes inteligência artificial", "piadas programação"]}
>
  <main class="memes-page">
    <header class="memes-hero">
      <div class="container">
        <h1>Humor Tech & IA 🤖</h1>
        <p class="hero-subtitle">
          Um respiro cômico para a comunidade. Porque se a gente não rir do código legado, a gente chora.
        </p>
        
        <div class="lang-toggle-wrap">
          <div class="lang-toggle" id="lang-toggle">
            <button class="active" data-lang="pt">🇧🇷 Títulos em PT</button>
            <button data-lang="en">🇺🇸 Títulos em EN</button>
          </div>
        </div>
      </div>
    </header>

    <section class="memes-grid-section">
      <div class="container">
        <div class="masonry-grid" id="memes-container" data-current-lang="pt">
          {memes.map(meme => (
            <div class="meme-card">
              <img src={meme.src} alt={meme.en} loading="lazy" />
              <div class="meme-overlay">
                <span class="meme-title-text" data-pt={meme.pt} data-en={meme.en}>{meme.pt}</span>
              </div>
            </div>
          ))}
        </div>
        
        <div class="submit-meme-box">
          <p>Fez um meme bom e quer colocar aqui?</p>
          <a href="/forum" class="btn btn-fill">Mande no Fórum</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('lang-toggle');
    if(!toggle) return;
    
    const buttons = toggle.querySelectorAll('button');
    const container = document.getElementById('memes-container');
    const texts = document.querySelectorAll('.meme-title-text');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        
        // Update buttons
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Update container lang
        container.setAttribute('data-current-lang', lang);
        
        // Update texts
        texts.forEach(textEl => {
          const newText = textEl.getAttribute(`data-${lang}`);
          if (newText) {
            textEl.innerHTML = newText;
          }
        });
      });
    });
  });
</script>

<style>
  .memes-page {
    padding-bottom: 80px;
  }
  .memes-hero {
    padding: 80px 0 40px;
    text-align: center;
    background: linear-gradient(180deg, var(--bg-2) 0%, transparent 100%);
  }
  .memes-hero h1 {
    margin-bottom: 16px;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.02em;
  }
  .hero-subtitle {
    max-width: 600px;
    margin: 0 auto;
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }
  
  .lang-toggle-wrap {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }
  .lang-toggle {
    display: inline-flex;
    background: var(--bg-3);
    border-radius: 100px;
    padding: 4px;
    border: 1px solid var(--border);
  }
  .lang-toggle button {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--sans);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lang-toggle button:hover {
    color: var(--text);
  }
  .lang-toggle button.active {
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    border: 1px solid var(--border);
  }
  
  .memes-grid-section {
    padding: 40px 0;
  }

  .memes-grid-section .container {
    max-width: 1150px;
  }

  /* Masonry Layout */
  .masonry-grid {
    column-count: 3;
    column-gap: 24px;
    padding-bottom: 60px;
  }
  
  @media (max-width: 900px) {
    .masonry-grid {
      column-count: 2;
    }
  }
  
  @media (max-width: 600px) {
    .masonry-grid {
      column-count: 1;
    }
  }

  .meme-card {
    break-inside: avoid;
    margin-bottom: 24px;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-2);
    border: 1px solid var(--border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .meme-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }

  .meme-card img {
    width: 100%;
    display: block;
    height: auto;
  }

  .meme-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 24px 20px 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .meme-card:hover .meme-overlay {
    opacity: 1;
  }

  .meme-title-text {
    font-weight: 600;
    font-size: 15px;
    font-family: var(--sans);
  }



  .submit-meme-box {
    margin: 0 auto;
    max-width: 500px;
    padding: 32px;
    text-align: center;
    border-radius: 16px;
    background: var(--bg-2);
    border: 1px dashed var(--border-hover);
  }

  .submit-meme-box p {
    margin-bottom: 16px;
    font-weight: 500;
    color: var(--text-muted);
  }
</style>
