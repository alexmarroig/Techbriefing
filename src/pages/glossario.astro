---
import BaseLayout from '../layouts/BaseLayout.astro';
import { client } from '../sanity/lib/client';

const terms = await client.fetch(`*[_type == "glossario"] | order(title asc)`);
---

<BaseLayout 
  title="Glossário de IA | Tech Briefing" 
  description="Um dicionário completo com os principais termos, siglas e conceitos do universo de Inteligência Artificial explicados de forma simples e direta para negócios."
  active="Glossario"
>
  <div class="archive-header">
    <div class="wrap">
      <h1>Glossário de IA</h1>
      <p>Entenda os jargões, siglas e conceitos do mercado de inteligência artificial sem complicação.</p>
    </div>
  </div>

  <div class="archive-grid wrap">
    {terms.map((term) => (
      <a href={`/glossario/${term.slug.current}`} class="archive-card">
        <h2>{term.title}</h2>
        <p>{term.description}</p>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .archive-header{
    padding: 96px 0 64px;
    border-bottom: 1px solid var(--line-s);
  }
  .archive-header h1{
    font-family: var(--serif);
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1;
    letter-spacing: -.03em;
    margin: 0 0 16px;
  }
  .archive-header p{
    color: var(--text-2);
    font-size: 19px;
    max-width: 600px;
    margin: 0;
  }
  .archive-grid{
    padding: 64px var(--pad);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
  .archive-card{
    display: block;
    padding: 24px;
    border: 1px solid var(--line-s);
    border-radius: 16px;
    background: var(--bg);
    transition: transform 0.2s, background 0.2s;
  }
  .archive-card:hover{
    transform: translateY(-4px);
    background: var(--bg-2);
  }
  .archive-card h2{
    font-family: var(--serif);
    font-size: 24px;
    margin: 0 0 12px;
    color: var(--amber);
  }
  .archive-card p{
    font-size: 15px;
    color: var(--text-2);
    line-height: 1.6;
    margin: 0;
  }
  @media(max-width: 768px){
    .archive-header{ padding: 64px 0 42px; }
    .archive-grid{ grid-template-columns: 1fr; }
  }
</style>
