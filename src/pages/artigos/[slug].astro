---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { client } from '../../sanity/lib/client';
import { articleBySlugQuery } from '../../sanity/lib/queries';
import PortableTextRenderer from '../../components/PortableTextRenderer.jsx';
import AuthorBio from '../../components/AuthorBio.astro';
import { resolveArticleImage, resolveOgImage } from '../../lib/articleImage';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const sanityArticles = await client.fetch(`*[_type == "article"]{ "slug": slug.current }`);
  const localArticles = await getCollection('articles');
  const slugs = new Set([
    ...sanityArticles.map((article) => article.slug),
    ...localArticles.map((article) => article.id),
  ]);

  return [...slugs].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const sanityEntry = await client.fetch(articleBySlugQuery, { slug });
const localArticles = await getCollection('articles');
const localEntry = localArticles.find((article) => article.id === slug);

const entry = sanityEntry ?? (localEntry ? {
  ...localEntry.data,
  body: null,
} : null);

if (!entry) return Astro.redirect('/404');

const { title, description, category, author, date, readTime, tags, faq = [], body } = entry;
const image = resolveArticleImage({
  slug,
  image: entry.image,
  title,
  category,
});
const ogImage = resolveOgImage({
  slug,
  image: entry.image,
});
const localRender = localEntry && !sanityEntry ? await render(localEntry) : null;
const LocalContent = localRender?.Content;
const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(new Date(date));
const articleUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 2, name: 'Arquivo', item: new URL('/arquivo/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: articleUrl },
  ],
};

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: ogImage ? new URL(ogImage, Astro.site ?? Astro.url).toString() : undefined,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Tech Briefing',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.ico', Astro.site ?? Astro.url).toString()
    }
  },
  datePublished: new Date(date).toISOString(),
  dateModified: new Date(date).toISOString(),
};

const faqJsonLd = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: any) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
} : null;

const schemas = [breadcrumbJsonLd, articleJsonLd];
if (faqJsonLd) schemas.push(faqJsonLd);
---

<BaseLayout
  title={`${title} - Tech Briefing`}
  description={description}
  image={ogImage}
  active="Artigo"
  type="article"
  publishedTime={new Date(date).toISOString()}
  modifiedTime={new Date(date).toISOString()}
  author={author}
  category={category}
  tags={tags}
  faq={faq}
  jsonLd={schemas}
>
  <div class="article-progress" aria-hidden="true"></div>

  <article class="seo-article">
    <div class="wrap">
      <nav class="seo-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/arquivo">Arquivo</a>
        <span>/</span>
        <span>{category}</span>
      </nav>

      <header class="seo-article-header">
        <div class="seo-tags">
          <span class="pill c">{category}</span>
          {tags?.slice(0, 3).map((tag) => <span class="pill">{tag}</span>)}
        </div>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="seo-meta">
          <span class="author-link">{author}</span>
          <span>{formattedDate}</span>
          <span>{readTime} de leitura</span>
        </div>
      </header>

      {image && (
        <figure class="seo-hero-image">
          <img src={image} alt={title} loading="eager" />
        </figure>
      )}

      <div class="seo-layout">
        <div class="seo-content">
          {body ? <PortableTextRenderer value={body} /> : null}
          {LocalContent ? <LocalContent /> : null}
          <AuthorBio author={author} />

          <div class="giscus-container" style="margin-top: 64px;">
            <script is:inline>
              (function() {
                const getTheme = () => document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
                
                const script = document.createElement('script');
                script.src = "https://giscus.app/client.js";
                script.setAttribute("data-repo", "alexmarroig/Techbriefing");
                script.setAttribute("data-repo-id", "R_kgDOSWXDkA");
                script.setAttribute("data-mapping", "pathname");
                script.setAttribute("data-strict", "0");
                script.setAttribute("data-reactions-enabled", "1");
                script.setAttribute("data-emit-metadata", "0");
                script.setAttribute("data-input-position", "bottom");
                script.setAttribute("data-theme", getTheme());
                script.setAttribute("data-lang", "pt");
                script.setAttribute("crossorigin", "anonymous");
                script.async = true;
                
                document.currentScript.parentNode.appendChild(script);

                const observer = new MutationObserver((mutations) => {
                  mutations.forEach((mutation) => {
                    if (mutation.attributeName === 'data-theme') {
                      const iframe = document.querySelector('iframe.giscus-frame');
                      if (iframe) {
                        iframe.contentWindow.postMessage(
                          { giscus: { setConfig: { theme: getTheme() } } },
                          'https://giscus.app'
                        );
                      }
                    }
                  });
                });
                observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
              })();
            </script>
          </div>
        </div>
      </div>
    </div>
  </article>

  <div class="article-product-nudge" data-article-product-nudge hidden>
    <button class="article-nudge-close" type="button" aria-label="Fechar oferta" data-nudge-close>&times;</button>
    <div class="article-nudge-kicker">Próximo passo</div>
    <strong>Quer aplicar isso no seu negócio?</strong>
    <p>Veja o guia prático de agentes de IA e transforme leitura em fluxo, tarefa e automação real.</p>
    <div class="article-nudge-actions">
      <a href="/ebook-agentes-ia/" class="article-nudge-primary" data-nudge-link="ebook">Ver ebook por R$ 37</a>
      <a href="/ferramentas/" class="article-nudge-secondary" data-nudge-link="tools">Ferramentas</a>
    </div>
  </div>

  <script is:inline>
    (() => {
      const nudge = document.querySelector('[data-article-product-nudge]');
      if (!nudge) return;

      const storageKey = 'tb_article_product_nudge_closed_v1';
      if (sessionStorage.getItem(storageKey) === '1') return;

      let visible = false;
      const track = (name, params = {}) => {
        if (typeof window.trackTechBriefingEvent === 'function') {
          window.trackTechBriefingEvent(name, {
            placement: 'article_product_nudge',
            ...params,
          });
        }
      };
      const show = (reason) => {
        if (visible) return;
        visible = true;
        nudge.hidden = false;
        track('product_nudge_view', { reason });
      };
      const close = () => {
        nudge.hidden = true;
        sessionStorage.setItem(storageKey, '1');
        track('product_nudge_close');
      };

      nudge.querySelectorAll('[data-nudge-close]').forEach((button) => {
        button.addEventListener('click', close);
      });
      nudge.querySelectorAll('[data-nudge-link]').forEach((link) => {
        link.addEventListener('click', () => {
          track('product_nudge_click', { target: link.getAttribute('data-nudge-link') });
        });
      });

      window.setTimeout(() => show('time'), 16000);
      window.addEventListener('scroll', () => {
        const trigger = Math.min(900, document.documentElement.scrollHeight * 0.22);
        if (window.scrollY > trigger) show('scroll');
      }, { passive: true });
    })();
  </script>
</BaseLayout>

<style>
  .article-progress {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 300;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--amber), var(--cyan));
    transform-origin: 0 50%;
    animation: article-progress linear;
    animation-timeline: scroll();
  }
  @keyframes article-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .seo-article {
    border-top: 1px solid var(--line-s);
  }
  .seo-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 22px 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-4);
    border-bottom: 1px solid var(--line-s);
  }
  .seo-breadcrumb a {
    color: var(--text-3);
  }
  .seo-article-header {
    max-width: 860px;
    padding: 72px 0 42px;
  }
  .seo-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .seo-article-header h1 {
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .seo-article-header p {
    max-width: 760px;
    margin: 0;
    color: var(--text-2);
    font-size: 20px;
    line-height: 1.65;
  }
  .seo-meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .seo-hero-image {
    margin: 0 0 52px;
    overflow: hidden;
    border: 1px solid var(--line-s);
    border-radius: 16px;
    background: var(--bg-2);
  }
  .seo-hero-image img {
    display: block;
    width: 100%;
    max-height: 460px;
    object-fit: cover;
  }
  .seo-layout {
    display: grid;
    grid-template-columns: minmax(0, 820px);
    justify-content: center;
    gap: 0;
    align-items: start;
    padding-bottom: 96px;
  }
  .seo-content {
    color: var(--text-2);
    font-size: 18px;
    line-height: 1.82;
  }
  .seo-content :global(h2) {
    margin: 56px 0 18px;
    color: var(--text);
    font-family: var(--serif);
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .seo-content :global(h3) {
    margin: 34px 0 12px;
    color: var(--text);
    font-size: 21px;
    line-height: 1.35;
  }
  .seo-content :global(h4),
  .seo-content :global(h5),
  .seo-content :global(h6) {
    margin: 28px 0 12px;
    color: var(--text);
    font-size: 18px;
    line-height: 1.4;
  }
  .seo-content :global(p) {
    margin: 0 0 22px;
  }
  .seo-content :global(a:not(.btn)) {
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .seo-content :global(ul),
  .seo-content :global(ol) {
    padding-left: 24px;
    margin: 0 0 28px;
  }
  .seo-content :global(li) {
    margin-bottom: 10px;
  }
  .seo-content :global(strong) {
    color: var(--text);
  }
  .seo-content :global(blockquote) {
    margin: 34px 0;
    padding: 24px 28px;
    border-left: 3px solid var(--amber);
    background: var(--bg-2);
    color: var(--text);
    border-radius: 0 12px 12px 0;
  }
  .seo-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 40px 0;
    border-radius: 12px;
    border: 1px solid var(--line-s);
  }
  .seo-content :global(pre) {
    background: oklch(0.1 0.01 245);
    color: rgba(255, 255, 255, 0.9);
    padding: 24px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 32px 0;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.6;
    border: 1px solid var(--line);
  }
  .seo-content :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--bg-3);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--amber);
  }
  .seo-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
    border-radius: 0;
  }
  .seo-content :global(hr) {
    border: none;
    border-top: 1px solid var(--line-s);
    margin: 48px 0;
    opacity: 0.6;
  }
  .seo-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
    font-size: 16px;
  }
  .seo-content :global(th),
  .seo-content :global(td) {
    text-align: left;
    padding: 16px;
    border-bottom: 1px solid var(--line-s);
  }
  .seo-content :global(th) {
    color: var(--text);
    font-weight: 600;
    background: var(--bg-2);
  }
  .seo-content :global(tr:nth-child(even)) {
    background: var(--bg-2);
  }
  .article-product-nudge[hidden] {
    display: none;
  }
  .article-product-nudge {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 420;
    width: min(360px, calc(100vw - 32px));
    padding: 20px;
    border: 1px solid oklch(0.80 0.14 62 / 0.32);
    border-radius: 16px;
    background:
      radial-gradient(circle at 92% 0%, oklch(0.80 0.14 62 / 0.16), transparent 48%),
      oklch(0.14 0.01 245 / 0.96);
    box-shadow: 0 20px 60px oklch(0 0 0 / 0.46);
    backdrop-filter: blur(14px);
  }
  .article-nudge-close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-s);
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--text-2);
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
  }
  .article-nudge-kicker {
    margin-bottom: 10px;
    color: var(--amber);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .article-product-nudge strong {
    max-width: 280px;
    color: #fff;
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .article-product-nudge p {
    margin: 12px 0 16px;
    color: #a1a1aa;
    font-size: 14px;
    line-height: 1.55;
  }
  .article-nudge-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .article-nudge-primary,
  .article-nudge-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }
  .article-nudge-primary {
    flex: 1;
    color: oklch(0.13 0.01 45) !important;
    background: var(--amber) !important;
  }
  .article-nudge-secondary {
    padding: 0 14px;
    color: #a1a1aa;
    border: 1px solid rgba(255,255,255,0.1);
  }
  @media(max-width: 980px) {
    .seo-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  @media(max-width: 640px) {
    .seo-article-header {
      padding: 48px 0 32px;
    }
    .seo-article-header p {
      font-size: 17px;
    }
    .seo-content {
      font-size: 16px;
    }
    .article-product-nudge {
      right: 12px;
      bottom: 12px;
      left: 12px;
      width: auto;
      padding: 18px;
    }
  }
</style>

<style is:global>
  .article-nudge-primary:hover {
    filter: brightness(1.1);
    transform: scale(1.02);
    transition: all 0.2s ease;
  }
  .article-nudge-close:hover {
    background: var(--bg-3);
    color: var(--text);
  }
</style>
