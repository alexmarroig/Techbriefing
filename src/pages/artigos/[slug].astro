---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export function getStaticPaths() {
  return getCollection('articles').then((entries) =>
    entries.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    })),
  );
}

const { entry } = Astro.props;
const { title, description, image, category, author, date, readTime, tags } = entry.data;
const { Content } = await render(entry);
const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(date);
const articleUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 2, name: 'Arquivo', item: new URL('/arquivo/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: articleUrl },
  ],
};
---

<BaseLayout
  title={`${title} - Tech Briefing`}
  description={description}
  image={image}
  active="Artigo"
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={date.toISOString()}
  author={author}
  category={category}
  tags={tags}
  jsonLd={[breadcrumbJsonLd]}
>
  <div class="article-progress" aria-hidden="true"></div>

  <article class="seo-article">
    <div class="wrap">
      <nav class="seo-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/arquivo">Arquivo</a>
        <span>/</span>
        <span>{category}</span>
      </nav>

      <header class="seo-article-header">
        <div class="seo-tags">
          <span class="pill c">{category}</span>
          {tags?.slice(0, 3).map((tag) => <span class="pill">{tag}</span>)}
        </div>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="seo-meta">
          <span>{author}</span>
          <span>{formattedDate}</span>
          <span>{readTime} de leitura</span>
        </div>
      </header>

      {image && (
        <figure class="seo-hero-image">
          <img src={image} alt="" loading="eager" />
        </figure>
      )}

      <div class="seo-layout">
        <div class="seo-content">
          <Content />
        </div>

        <aside class="seo-sidebar" aria-label="Oferta relacionada">
          <div class="seo-offer-card">
            <div class="seo-offer-kicker">Ebook recomendado</div>
            <h2>Agentes de IA para Negócios</h2>
            <p>Saia do ChatGPT solto e aprenda a estruturar agentes que executam processos reais.</p>
            <div class="seo-offer-price">
              <span>R$ 37</span>
              <small>PDF + EPUB</small>
            </div>
            <a href="/ebook-agentes-ia/" class="btn btn-fill">Ver ebook →</a>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-progress {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 300;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--amber), var(--cyan));
    transform-origin: 0 50%;
    animation: article-progress linear;
    animation-timeline: scroll();
  }
  @keyframes article-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .seo-article {
    border-top: 1px solid var(--line-s);
  }
  .seo-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 22px 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-4);
    border-bottom: 1px solid var(--line-s);
  }
  .seo-breadcrumb a {
    color: var(--text-3);
  }
  .seo-article-header {
    max-width: 860px;
    padding: 72px 0 42px;
  }
  .seo-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .seo-article-header h1 {
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .seo-article-header p {
    max-width: 760px;
    margin: 0;
    color: var(--text-2);
    font-size: 20px;
    line-height: 1.65;
  }
  .seo-meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .seo-hero-image {
    margin: 0 0 52px;
    overflow: hidden;
    border: 1px solid var(--line-s);
    border-radius: 16px;
    background: var(--bg-2);
  }
  .seo-hero-image img {
    display: block;
    width: 100%;
    max-height: 460px;
    object-fit: cover;
  }
  .seo-layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 300px;
    gap: 64px;
    align-items: start;
    padding-bottom: 96px;
  }
  .seo-content {
    color: var(--text-2);
    font-size: 18px;
    line-height: 1.82;
  }
  .seo-content :global(h2) {
    margin: 56px 0 18px;
    color: var(--text);
    font-family: var(--serif);
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .seo-content :global(h3) {
    margin: 34px 0 12px;
    color: var(--text);
    font-size: 21px;
    line-height: 1.35;
  }
  .seo-content :global(p) {
    margin: 0 0 22px;
  }
  .seo-content :global(a) {
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .seo-content :global(ul),
  .seo-content :global(ol) {
    padding-left: 24px;
    margin: 0 0 28px;
  }
  .seo-content :global(li) {
    margin-bottom: 10px;
  }
  .seo-content :global(strong) {
    color: var(--text);
  }
  .seo-content :global(blockquote) {
    margin: 34px 0;
    padding: 24px 28px;
    border-left: 3px solid var(--amber);
    background: var(--bg-2);
    color: var(--text);
    border-radius: 0 12px 12px 0;
  }
  .seo-sidebar {
    position: sticky;
    top: 92px;
  }
  .seo-offer-card {
    padding: 24px;
    border: 1px solid oklch(0.80 0.14 62 / 0.24);
    border-radius: 14px;
    background:
      radial-gradient(circle at 80% 0%, oklch(0.80 0.14 62 / 0.14), transparent 55%),
      var(--bg-2);
  }
  .seo-offer-kicker {
    margin-bottom: 12px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--amber);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .seo-offer-card h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.1;
  }
  .seo-offer-card p {
    margin: 0 0 18px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }
  .seo-offer-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 18px;
  }
  .seo-offer-price span {
    color: var(--amber);
    font-family: var(--serif);
    font-size: 34px;
    font-weight: 700;
  }
  .seo-offer-price small {
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .seo-offer-card .btn {
    width: 100%;
    justify-content: center;
  }
  @media(max-width: 980px) {
    .seo-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .seo-sidebar {
      position: static;
    }
  }
  @media(max-width: 640px) {
    .seo-article-header {
      padding: 48px 0 32px;
    }
    .seo-article-header p {
      font-size: 17px;
    }
    .seo-content {
      font-size: 16px;
    }
  }
</style>
