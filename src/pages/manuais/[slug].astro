---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MANUALS, getManualBySlug } from '../../data/manuals.js';

export function getStaticPaths() {
  return MANUALS.map((manual) => ({
    params: { slug: manual.slug },
    props: { manual },
  }));
}

const { manual } = Astro.props;
const related = MANUALS.filter((item) => item.slug !== manual.slug && item.category === manual.category).slice(0, 3);
const manualIndex = MANUALS.findIndex((item) => item.slug === manual.slug);
const score = {
  difficulty: 46 + ((manualIndex * 13) % 38),
  cost: 32 + ((manual.tools.length * 11 + manualIndex * 5) % 44),
  speed: 58 + ((manualIndex * 9) % 34),
};
const isReview = manual.category === 'Review';
const isVideo = manual.category.includes('Vídeo');
const isAgent = manual.category.includes('Agentes');
const isVoice = manual.category.includes('Voz');
const primaryTool = manual.tools[0];
const starterPrompt = `Quero criar ${manual.title.toLowerCase()} para um projeto real. Meu objetivo é [descreva o resultado], meu público é [descreva o público] e minhas restrições são [tempo/orçamento/ferramentas]. Monte um plano prático com: ferramentas recomendadas, passo a passo, riscos, checklist de qualidade e uma primeira versão simples para testar hoje.`;
const categoryGuide = isVoice
  ? {
      promise: 'transformar roteiro em presença: voz, rosto, ritmo e confiança',
      asset: 'um vídeo curto narrado, com avatar ou voz sintética, pronto para testar em uma página, anúncio ou rede social',
      niche: 'um consultor que quer gravar aulas e anúncios sem depender de estúdio toda semana',
      thirty: ['Escreva um roteiro de 90 segundos', 'Gere 3 versões de voz', 'Escolha a mais natural', 'Monte com legenda grande', 'Publique como teste privado ou anúncio pequeno'],
    }
  : isVideo
    ? {
        promise: 'transformar uma ideia simples em peça visual que prende atenção',
        asset: 'um vídeo vertical com gancho, legenda, imagem forte e chamada para ação',
        niche: 'um criador que quer transformar uma notícia, aula ou oferta em cortes que geram clique',
        thirty: ['Escolha um gancho visual', 'Escreva roteiro de 8 a 20 segundos', 'Gere 2 variações', 'Edite legenda e ritmo', 'Publique 3 versões com aberturas diferentes'],
      }
    : isAgent
      ? {
          promise: 'tirar uma tarefa da cabeça e colocar em um fluxo que executa com regra',
          asset: 'um agente pequeno que recebe uma entrada, usa ferramentas e devolve uma saída revisável',
          niche: 'um prestador de serviço que perde tempo pesquisando, respondendo ou organizando informação manualmente',
          thirty: ['Escolha uma tarefa repetitiva', 'Defina entrada e saída', 'Liste ferramentas permitidas', 'Teste com 3 casos reais', 'Adicione revisão humana antes de publicar'],
        }
      : isReview
        ? {
            promise: 'decidir ferramenta com base em custo, uso real e limite, não em demo bonita',
            asset: 'uma matriz simples para escolher o app certo antes de pagar assinatura',
            niche: 'um freelancer que precisa produzir rápido, mas não pode gastar em cinco ferramentas ao mesmo tempo',
            thirty: ['Defina o resultado que você quer', 'Teste o mesmo prompt em 3 apps', 'Anote custo por entrega aprovada', 'Compare velocidade e controle', 'Escolha uma ferramenta principal e uma reserva'],
          }
        : {
            promise: 'transformar conhecimento em rotina, audiência e oferta vendável',
            asset: 'um processo repetível para publicar, capturar leads ou vender um serviço simples',
            niche: 'um profissional que quer usar IA para criar demanda, não só consumir novidade',
            thirty: ['Escolha uma dor clara', 'Monte uma entrega pequena', 'Crie uma prova visual', 'Publique com CTA', 'Meça resposta e ajuste a oferta'],
          };
const useCases = isVoice
  ? ['Aulas e cursos com narração consistente', 'Anúncios curtos sem precisar gravar toda semana', 'Atendimento, onboarding e vídeos de venda com avatar']
  : isVideo
    ? ['Conteúdo curto para Reels, Shorts e TikTok', 'Transformar aulas, lives e podcasts em ativos de tráfego', 'Criar provas visuais para ofertas e páginas de venda']
    : isAgent
      ? ['Pesquisa e resumo automático de informações', 'Execução de tarefas repetitivas com revisão humana', 'Automação de operação, suporte, vendas e conteúdo']
      : isReview
        ? ['Escolher ferramenta antes de gastar assinatura', 'Comparar custo real por entrega aprovada', 'Decidir stack para produção, teste e escala']
        : ['Criar rotina editorial recorrente', 'Empacotar técnica como serviço vendável', 'Aumentar velocidade de produção sem perder controle'];
const faq = [
  {
    q: 'Preciso saber programar?',
    a: isAgent
      ? 'Ajuda, mas não é obrigatório para começar. O mais importante é desenhar bem a tarefa, limitar permissões e testar com casos pequenos antes de automatizar processos sensíveis.'
      : 'Não. Para começar, você precisa entender o fluxo, escolher uma ferramenta simples e revisar o resultado com critério.',
  },
  {
    q: 'Dá para usar comercialmente?',
    a: 'Depende da ferramenta e do plano. Antes de publicar para cliente ou anúncio, confira licença comercial, política de voz/imagem e direitos dos assets usados.',
  },
  {
    q: 'Qual é o erro mais caro?',
    a: manual.mistakes[0] || 'Começar grande demais. Primeiro valide uma versão simples, depois melhore qualidade, automação e escala.',
  },
];
const decisionRows = manual.tools.map((tool, index) => ({
  tool,
  bestFor: index === 0 ? 'primeiro teste sério' : index === 1 ? 'comparar qualidade e preço' : index === 2 ? 'variações e casos específicos' : 'produção complementar',
  watch: index === 0 ? 'limites do plano e licença comercial' : index === 1 ? 'curva de aprendizado' : 'qualidade final antes de publicar',
}));
---

<BaseLayout
  title={`${manual.title} — Manual Tech Briefing`}
  description={manual.description}
  active="Manuais"
>
  <main class="manual-detail">
    <section class="manual-detail-hero">
      <div class="wrap">
        <a class="manual-back" href="/manuais/">← Todos os manuais</a>
        <div class="manual-detail-hero-grid">
          <div>
            <div class="manual-detail-kicker">{manual.category}</div>
            <h1>{manual.title}</h1>
            <p>{manual.description}</p>
            <div class="manual-outcome">
              <span>Resultado esperado</span>
              <strong>{manual.outcome}</strong>
            </div>
          </div>
          <figure class="manual-visual" aria-label={`Painel visual do manual ${manual.title}`}>
            <div class="manual-visual-grid"></div>
            <div class="manual-visual-orb one"></div>
            <div class="manual-visual-orb two"></div>
            <div class="manual-visual-card">
              <span>{manual.category}</span>
              <strong>{manual.title}</strong>
              <p>{primaryTool} + processo + revisão humana</p>
            </div>
            <div class="manual-visual-flow">
              <i></i><i></i><i></i>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="manual-detail-body">
      <div class="wrap manual-detail-grid">
        <article class="manual-detail-content">
          <section class="manual-prose-section">
            <h2>O que você vai construir</h2>
            <p>
              Este manual existe para {categoryGuide.promise}. A meta não é testar IA por testar.
              A meta é terminar com {categoryGuide.asset}.
            </p>
            <p>
              Pense no caso de {categoryGuide.niche}. A diferença entre brincar com ferramenta e aplicar
              de verdade está no processo: objetivo claro, teste pequeno, revisão humana e uma próxima ação
              mensurável.
            </p>
          </section>

          <section class="manual-playbook">
            <div>
              <span>Receita de 30 minutos</span>
              <h2>Faça uma primeira versão hoje</h2>
              <p>Não espere o setup perfeito. A primeira vitória é criar algo pequeno o bastante para publicar, medir e melhorar.</p>
            </div>
            <ol>
              {categoryGuide.thirty.map((item) => <li>{item}</li>)}
            </ol>
          </section>

          <section class="manual-chart-section">
            <h2>Mapa rápido do esforço</h2>
            <div class="manual-chart">
              <div>
                <span>Dificuldade</span>
                <b style={`--v:${score.difficulty}%`}><i></i></b>
                <em>{score.difficulty}/100</em>
              </div>
              <div>
                <span>Custo inicial</span>
                <b style={`--v:${score.cost}%`}><i></i></b>
                <em>{score.cost}/100</em>
              </div>
              <div>
                <span>Velocidade para testar</span>
                <b style={`--v:${score.speed}%`}><i></i></b>
                <em>{score.speed}/100</em>
              </div>
            </div>
          </section>

          <section class="manual-prose-section">
            <h2>Quando vale usar</h2>
            <div class="manual-use-grid">
              {useCases.map((useCase) => <div>{useCase}</div>)}
            </div>
          </section>

          <h2>Passo a passo</h2>
          <ol class="manual-steps">
            {manual.steps.map((step) => <li>{step}</li>)}
          </ol>

          <h2>Ferramentas para começar</h2>
          <div class="manual-tool-table">
            {decisionRows.map((row, index) => (
              <div class="manual-tool-row">
                <strong>{row.tool}</strong>
                <span>{index === 0 ? 'Melhor ponto de partida' : index === 1 ? 'Boa alternativa para comparar' : 'Use para testar variações'}</span>
                <em>{index === 0 ? 'Prioridade alta' : index === 1 ? 'Prioridade média' : 'Opcional'}</em>
              </div>
            ))}
          </div>

          <h2>Matriz de decisão</h2>
          <div class="manual-decision-table">
            <div class="manual-decision-head">
              <span>Ferramenta</span>
              <span>Use quando</span>
              <span>Atenção</span>
            </div>
            {decisionRows.map((row) => (
              <div class="manual-decision-row">
                <strong>{row.tool}</strong>
                <span>{row.bestFor}</span>
                <span>{row.watch}</span>
              </div>
            ))}
          </div>

          <h2>Prompt para copiar</h2>
          <div class="manual-prompt">
            <button type="button" data-copy-manual-prompt>Copiar prompt</button>
            <pre><code>{starterPrompt}</code></pre>
          </div>

          <h2>Erros que mais travam</h2>
          <div class="manual-mistakes">
            {manual.mistakes.map((mistake) => <div>{mistake}</div>)}
          </div>

          <h2>Checklist antes de publicar</h2>
          <div class="manual-checklist">
            {[
              'O resultado tem um objetivo claro e mensurável.',
              'Você revisou direitos de uso, voz, imagem e licença comercial.',
              'O arquivo final foi testado no celular.',
              'Existe uma versão simples para publicar hoje.',
              'Você salvou o processo para repetir ou vender depois.',
            ].map((item) => <label><input type="checkbox" /> <span>{item}</span></label>)}
          </div>

          <h2>Como transformar isso em aplicação real</h2>
          <p>
            Pegue um caso pequeno, execute uma versão simples, compare antes e depois, salve o processo
            e só então transforme em rotina, serviço ou conteúdo. IA aplicada não começa grande: começa
            com um fluxo que funciona uma vez e depois fica repetível.
          </p>

          <div class="manual-publish-plan">
            <span>Plano de publicação</span>
            <h2>Como tirar do teste e levar para o mundo</h2>
            <div>
              <p><strong>Dia 1:</strong> publique a versão simples para um grupo pequeno ou em modo privado.</p>
              <p><strong>Dia 2:</strong> ajuste o que ficou artificial, lento, confuso ou caro.</p>
              <p><strong>Dia 3:</strong> transforme em artigo, post curto, oferta, vídeo ou demonstração para cliente.</p>
            </div>
          </div>

          <h2>Perguntas frequentes</h2>
          <div class="manual-faq">
            {faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </article>

        <aside class="manual-detail-side">
          <div class="manual-side-card">
            <span>Ferramentas citadas</span>
            <div class="manual-tools detail">
              {manual.tools.map((tool) => <a href="/ferramentas/">{tool}</a>)}
            </div>
          </div>
          <div class="manual-side-card">
            <span>Próximo passo</span>
            <strong>Receba os próximos guias práticos por e-mail.</strong>
            <a class="btn btn-fill" href="/newsletter/">Entrar na newsletter →</a>
          </div>
        </aside>
      </div>
    </section>

    {related.length > 0 && (
      <section class="manual-related">
        <div class="wrap">
          <div class="manuals-section-head">
            <span>Relacionados</span>
            <p>Continue na mesma trilha.</p>
          </div>
          <div class="manuals-ideas-grid">
            {related.map((item) => (
              <a class="manual-idea link" href={`/manuais/${item.slug}/`}>
                <span>{item.category}</span>
                <strong>{item.title}</strong>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <script is:inline>
    (() => {
      const button = document.querySelector('[data-copy-manual-prompt]');
      const code = document.querySelector('.manual-prompt code');
      if (!button || !code || !navigator.clipboard) return;
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(code.textContent || '');
        button.textContent = 'Copiado';
        window.setTimeout(() => { button.textContent = 'Copiar prompt'; }, 1600);
      });
    })();
  </script>
</BaseLayout>
