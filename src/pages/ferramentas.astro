---
import BaseLayout from '../layouts/BaseLayout.astro';
import FerramentasPage from '../components/pages/FerramentasPage.jsx';
import { client } from '../sanity/lib/client';

const fetchedTools = await client.fetch(`*[_type == "tool"]`);
const tools = fetchedTools.map((entry) => ({
  slug: entry.slug.current,
  ...entry,
}));
---

<BaseLayout title="Ferramentas Recomendadas - Tech Briefing" description="Ferramentas de IA, automação e produtividade avaliadas para uso profissional." active="Ferramentas">
  <FerramentasPage tools={tools} client:load />
</BaseLayout>
