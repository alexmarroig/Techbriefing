---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparativoPage from '../../components/pages/ComparativoPage.jsx';
import { client } from '../../sanity/lib/client';

export async function getStaticPaths() {
  const comparativos = await client.fetch(`*[_type == "comparativo"]{ "slug": slug.current }`);
  const uniqueSlugs = [...new Set(comparativos.map(c => c.slug))];
  return uniqueSlugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const entry = await client.fetch(`*[_type == "comparativo" && slug.current == $slug][0]`, { slug });

if (!entry) return Astro.redirect('/404');

const { title, description, image, author, date, category, tools, faq } = entry;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 2, name: 'Comparativos', item: new URL('/comparativos/n8n-vs-make/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${title} - Tech Briefing`}
  description={description}
  image={image}
  active="Comparativo"
  type="article"
  publishedTime={date ? new Date(date).toISOString() : ''}
  modifiedTime={date ? new Date(date).toISOString() : ''}
  author={author}
  category={category}
  tags={tools}
  faq={faq}
  jsonLd={[breadcrumbJsonLd]}
>
  <ComparativoPage entry={{ slug: slug, ...entry }} client:load />
</BaseLayout>
