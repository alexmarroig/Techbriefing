---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparativoPage from '../../components/pages/ComparativoPage.jsx';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return getCollection('comparativos').then((entries) =>
    entries.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    })),
  );
}

const { entry } = Astro.props;
const { title, description, image, author, date, category, tools } = entry.data;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 2, name: 'Comparativos', item: new URL('/comparativos/n8n-vs-make/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${title} - Tech Briefing`}
  description={description}
  image={image}
  active="Comparativo"
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={date.toISOString()}
  author={author}
  category={category}
  tags={tools}
  jsonLd={[breadcrumbJsonLd]}
>
  <ComparativoPage entry={{ slug: entry.id, ...entry.data }} client:load />
</BaseLayout>
