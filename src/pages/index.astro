---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexPage from '../components/pages/IndexPage.jsx';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    slug: entry.id,
    href: `/artigos/${entry.id}`,
    ...entry.data,
  }));

const tools = (await getCollection('tools')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));

const apps = (await getCollection('apps')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));

const ebooks = (await getCollection('ebooks')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));
---

<BaseLayout title="Tech Briefing — Notícias, guias e prompts para aplicar IA de verdade" description="Notícias filtradas, guias práticos, prompts gratuitos, reviews e comparativos para aplicar IA no trabalho, no negócio e nos produtos digitais." active="Notícias" impactSiteVerification="ef23250f-43c7-4882-b520-044d5c8285f9">
  <IndexPage articles={articles} tools={tools} apps={apps} ebooks={ebooks} />
</BaseLayout>
