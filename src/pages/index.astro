---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexPage from '../components/pages/IndexPage.jsx';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    slug: entry.id,
    href: `/artigos/${entry.id}`,
    ...entry.data,
  }));

const tools = (await getCollection('tools')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));

const apps = (await getCollection('apps')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));

const ebooks = (await getCollection('ebooks')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));
---

<BaseLayout title="Tech Briefing — Inteligência Artificial Aplicada" description="Notícias e ideias para aplicar IA de verdade, com manuais práticos, reviews de ferramentas e guias para transformar tecnologia em resultado." active="Notícias" impactSiteVerification="5653ecf3-3e63-479d-9409-5fb3741465dd">
  <IndexPage articles={articles} tools={tools} apps={apps} ebooks={ebooks} />
</BaseLayout>
