---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexPage from '../components/pages/IndexPage.jsx';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    slug: entry.id,
    href: `/artigos/${entry.id}`,
    ...entry.data,
  }));

const tools = (await getCollection('tools')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));

const apps = (await getCollection('apps')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));

const ebooks = (await getCollection('ebooks')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));
---

<BaseLayout title="Tech Briefing - Inteligencia Artificial Aplicada" description="Analises, guias e ferramentas para aplicar inteligencia artificial em negocios, produtos e trabalho." active="Home">
  <IndexPage articles={articles} tools={tools} apps={apps} ebooks={ebooks} client:load />
</BaseLayout>
