---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export function getStaticPaths() {
  return getCollection('glossario').then((entries) =>
    entries.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    })),
  );
}

const { entry } = Astro.props;
const { title, description, author, date } = entry.data;
const { Content } = await render(entry);
const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(date);
const url = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 2, name: 'Glossário de IA', item: new URL('/glossario/', Astro.site ?? Astro.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<BaseLayout
  title={`${title} - Glossário Tech Briefing`}
  description={description}
  active="Glossario"
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={date.toISOString()}
  author={author}
  category="Glossário de IA"
  jsonLd={[breadcrumbJsonLd]}
>
  <article class="seo-article">
    <div class="seo-layout">
      <header class="seo-article-header">
        <div class="seo-breadcrumb">
          <a href="/">Home</a> / <a href="/glossario">Glossário</a> / <span>Termo</span>
        </div>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="seo-meta">
          <span>Por {author}</span>
          <span>&bull;</span>
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
      </header>

      <div class="seo-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .seo-article {
    border-top: 1px solid var(--line-s);
  }
  .seo-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 22px 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-4);
    border-bottom: 1px solid var(--line-s);
  }
  .seo-breadcrumb a {
    color: var(--text-3);
  }
  .seo-article-header {
    max-width: 860px;
    padding: 72px 0 42px;
  }
  .seo-article-header h1 {
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .seo-article-header p {
    max-width: 760px;
    margin: 0;
    color: var(--text-2);
    font-size: 20px;
    line-height: 1.65;
  }
  .seo-meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .seo-layout {
    display: grid;
    grid-template-columns: minmax(0, 820px);
    justify-content: center;
    gap: 0;
    align-items: start;
    padding-bottom: 96px;
  }
  .seo-content {
    color: var(--text-2);
    font-size: 18px;
    line-height: 1.82;
  }
  .seo-content :global(h2) {
    margin: 56px 0 18px;
    color: var(--text);
    font-family: var(--serif);
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .seo-content :global(h3) {
    margin: 34px 0 12px;
    color: var(--text);
    font-size: 21px;
    line-height: 1.35;
  }
  .seo-content :global(p) {
    margin: 0 0 22px;
  }
  .seo-content :global(a) {
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .seo-content :global(ul),
  .seo-content :global(ol) {
    padding-left: 24px;
    margin: 0 0 28px;
  }
  .seo-content :global(li) {
    margin-bottom: 10px;
  }
  .seo-content :global(strong) {
    color: var(--text);
  }
  @media(max-width: 640px) {
    .seo-article-header {
      padding: 48px 0 32px;
    }
    .seo-article-header p {
      font-size: 17px;
    }
    .seo-content {
      font-size: 16px;
    }
  }
</style>
