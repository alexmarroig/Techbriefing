---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import GoogleTag from '../components/GoogleTag.astro';

const {
  title = 'Tech Briefing — Inteligência Artificial Aplicada',
  description = 'Guias práticos, comparativos honestos e ferramentas testadas sobre inteligência artificial, automação e negócios digitais.',
  active = '',
  image = '/images/og-default.png',
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const siteName = 'Tech Briefing';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#121417" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? Astro.url).toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Space+Grotesk:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <!-- Google Analytics — substitua G-XXXXXXXXXX pelo seu ID -->
    <GoogleTag />
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === 'article' ? 'Article' : 'WebSite',
      "name": title,
      "description": description,
      "url": canonical,
      "image": new URL(image, Astro.site ?? Astro.url).toString(),
      "publisher": {
        "@type": "Organization",
        "name": "Tech Briefing",
        "url": "https://techbriefing.com.br",
        "logo": { "@type": "ImageObject", "url": "https://techbriefing.com.br/favicon.svg" }
      },
      ...(type === 'article' ? { "author": { "@type": "Organization", "name": "Nexora Systems" }, "datePublished": new Date().toISOString() } : {}),
      ...(type !== 'article' ? { "potentialAction": { "@type": "SearchAction", "target": "https://techbriefing.com.br/arquivo?q={search_term_string}", "query-input": "required name=search_term_string" } } : {})
    })} />
  </head>
  <body>
    <Navbar active={active} />
    <slot />
    <Footer active={active} />
  </body>
</html>
