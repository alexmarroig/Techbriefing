---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import GoogleTag from '../components/GoogleTag.astro';
import AdSense from '../components/AdSense.astro';

const {
  title = 'Tech Briefing — Inteligência Artificial Aplicada',
  description = 'Guias práticos, comparativos honestos e ferramentas testadas sobre inteligência artificial, automação e negócios digitais.',
  active = '',
  image = '/images/og-default.webp',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Nexora Systems',
  category,
  tags = [],
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const siteName = 'Tech Briefing';
const absoluteImage = new URL(image, Astro.site ?? Astro.url).toString();
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://www.techbriefing.com.br/#organization',
    name: 'Tech Briefing',
    alternateName: 'Nexora Systems',
    url: 'https://www.techbriefing.com.br',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.techbriefing.com.br/favicon.svg',
    },
    sameAs: [],
  },
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        url: canonical,
        image: absoluteImage,
        datePublished: publishedTime,
        dateModified: modifiedTime || publishedTime,
        author: {
          '@type': 'Organization',
          name: author,
          url: 'https://www.techbriefing.com.br/sobre/',
        },
        publisher: {
          '@id': 'https://www.techbriefing.com.br/#organization',
        },
        articleSection: category,
        keywords: Array.isArray(tags) ? tags.join(', ') : tags,
        inLanguage: 'pt-BR',
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': 'https://www.techbriefing.com.br/#website',
        name: siteName,
        description,
        url: 'https://www.techbriefing.com.br',
        publisher: {
          '@id': 'https://www.techbriefing.com.br/#organization',
        },
        potentialAction: {
          '@type': 'SearchAction',
          target: 'https://www.techbriefing.com.br/arquivo/?q={search_term_string}',
          'query-input': 'required name=search_term_string',
        },
        inLanguage: 'pt-BR',
      },
  ...jsonLd,
].filter(Boolean);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#121417" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {(modifiedTime || publishedTime) && <meta property="article:modified_time" content={modifiedTime || publishedTime} />}
    {category && <meta property="article:section" content={category} />}
    {Array.isArray(tags) && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <GoogleTag />
    <AdSense />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body>
    <GoogleTag mode="body" />
    <Navbar active={active} />
    <main id="conteudo-principal">
      <slot />
    </main>
    <Footer active={active} />
  </body>
</html>
